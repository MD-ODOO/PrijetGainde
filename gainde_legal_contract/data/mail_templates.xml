<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_contract_alert" model="mail.template">
        <field name="name">Contrat : Alerte Expiration</field>
        <field name="model_id" ref="gainde_legal_contract.model_legal_contract"/>
        <field name="subject">Alerte : Échéance du contrat {{ object.name }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px; font-family: 'Segoe UI', Roboto, sans-serif;">
                <p>Bonjour,</p>
                <p>Nous vous informons que le contrat
                    <strong><t t-out="object.name"/></strong>
                    arrive à échéance le
                    <strong><t t-out="format_date(object.date_end)"/></strong>.
                </p>
                <div style="margin: 16px 0px 16px 0px;">
                    <a t-att-href="'/web#id=%s&amp;model=legal.contract&amp;view_type=form' % (object.id)"
                       style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                        Voir le Contrat
                    </a>
                </div>
                <p>Cordialement,</p>
                <p style="color: #666666;">Ceci est un message automatique de la gestion juridique.</p>
            </div>
        </field>
    </record>
</odoo>
