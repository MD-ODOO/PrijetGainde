<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1" évite de réinitialiser l'heure d'exécution à chaque mise à jour -->


        <record id="cron_alert_contract_expirations" model="ir.cron">
            <field name="name">Juridique : Vérification des expirations de contrats</field>
            <field name="model_id" ref="model_legal_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_alert_expirations()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 01:00:00')"/>
        </record>


</odoo>
