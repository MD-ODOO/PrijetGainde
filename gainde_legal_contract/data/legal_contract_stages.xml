<odoo>
    <data noupdate="1">
    <record id="contract_stage_draft" model="legal.contract.stage">
        <field name="name">Création</field>
        <field name="sequence">1</field>
    </record>

    <record id="contract_stage_negotiation" model="legal.contract.stage">
        <field name="name">Négociation</field>
        <field name="sequence">2</field>
    </record>

    <record id="contract_stage_validation" model="legal.contract.stage">
        <field name="name">Validation</field>
        <field name="sequence">3</field>
    </record>

    <record id="contract_stage_signed" model="legal.contract.stage">
        <field name="name">Signature</field>
        <field name="sequence">4</field>
    </record>

    <record id="contract_stage_execution" model="legal.contract.stage">
        <field name="name">Exécution</field>
        <field name="sequence">5</field>
    </record>
    <record id="contract_stage_closed" model="legal.contract.stage">
        <field name="name">Cloturé</field>
        <field name="sequence">6</field>
        <field name="fold" eval="True"/>
    </record>
    </data>
</odoo>
