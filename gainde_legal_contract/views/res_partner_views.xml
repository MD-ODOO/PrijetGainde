<odoo>
    <record id="view_partner_form_inherit_ninea" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.ninea</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="x_ninea" placeholder="Ex: 1234567 2G3" string="NINEA / COFI"/>
            </xpath>
        </field>
    </record>
</odoo>
