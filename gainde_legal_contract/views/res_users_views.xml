<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_simple_modif_inherit_sign_api" model="ir.ui.view">
        <field name="name">res.users.preferences.form.inherit.sign.api</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <!-- On se greffe après le champ email qui existe forcément -->
            <xpath expr="//field[@name='email']" position="after">
                <group string="Signature API">
                    <field name="id_signer"/>
                    <field name="worker_id"/>
                    <field name="visual_signature" widget="image"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
