<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Liste -->
    <record id="view_legal_contract_type_list" model="ir.ui.view">
        <field name="name">legal.contract.type.list</field>
        <field name="model">legal.contract.type</field>
        <field name="arch" type="xml">
            <list> <!-- Option : permet l'édition directe -->
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Vue Formulaire -->
    <record id="view_legal_contract_type_form" model="ir.ui.view">
        <field name="name">legal.contract.type.form</field>
        <field name="model">legal.contract.type</field>
        <field name="arch" type="xml">
            <form string="Type de Contrat">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nom du type"/>
                        <h4>
                            <field name="name" placeholder="Ex: Maintenance, Prestation de service..."/>
                        </h4>
                    </div>
                    <group>
                        <group string="details">
                            <field name="description" placeholder="Description courte du type de contrat..."/>
<!--                            <field name="code" placeholder="PRST-PHY-G2K, PRST-MORALE-G2K, PRT-ACORD-G2K, NDA-G2K"/>-->
                            <field name="category"/>

                        </group>
                        <group string="Lie le template">
                            <field name="template_id"
                                   domain="[('model', '=', 'legal.contract'), ('report_type', '=', 'qweb-pdf')]"
                                   help="Modèle PDF utilisé pour générer automatiquement les contrats de ce type"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Articles Standards">
                            <field name="article_template_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="content"/>
                                </list>
                            </field>
                        </page>
                        <page string="Modèle d'En-tête (Header)" name="header_config">
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle"/>
                        Utilisez les balises suivantes pour l'automatisation :
                        <strong>{{partner_name}}</strong>,
                        <strong>{{ninea}}</strong>,
                        <strong>{{rccm}}</strong>,
                        <strong>{{adresse}}</strong>.
                        <strong>{{representant}}</strong>.
                        <strong>{{{cni}}</strong>.
                    </div>
                    <!-- Widget HTML avec options de style inline pour le PDF -->
                    <field name="header_template"
                           widget="html"
                           options="{'style-inline': true, 'resizable': true}"/>
                </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action Fenêtre -->
    <record id="action_legal_contract_type" model="ir.actions.act_window">
        <field name="name">Types de Contrat</field>
        <field name="res_model">legal.contract.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
