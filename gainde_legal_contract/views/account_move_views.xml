<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_sign" model="ir.ui.view">
        <field name="name">account.move.form.inherit.sign</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <!-- Déclaration du champ technique pour la v18 -->
                <field name="sign_status" invisible="1"/>

                <button name="action_sign_document"
                        string="Signer PDF"
                        type="object"
                        class="btn-secondary"
                        icon="fa-pencil"
                        invisible="state != 'posted' or move_type not in ['out_invoice', 'in_invoice'] or sign_status == 'signed'"/>
            </xpath>
        </field>
    </record>
</odoo>
