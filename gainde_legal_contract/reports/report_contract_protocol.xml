<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_contract_protocol">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <!-- DEBUT HEADER -->
                    <div class="header">
                        <div class="row">
                            <div class="col-6">
                                <!-- Logo Entreprise ou Logo du Module par défaut -->
                                <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)"
                                     style="max-height: 70px;"/>
                                <img t-else="" src="/gainde_legal_contract/static/src/img/img.png"
                                     style="max-height: 70px;"/>
                            </div>
                            <div class="col-6 text-end">
                                <br/>
                                <span t-field="doc.name"/>
                            </div>
                        </div>
                        <!-- Titre Centré entre lignes bleues -->
                        <div style="border-bottom: 2px solid #0055A4; margin-top: 10px;"/>
                        <div class="text-center"
                             style="padding: 15px 0; font-weight: bold; font-size: 18px; color: #0055A4;">
                            PROTOCOLE D’ACCORD
                        </div>
                        <div style="border-bottom: 2px solid #0055A4; margin-bottom: 30px;"/>

                    </div>
                    <!-- FIN HEADER -->
                    <div class="page" style="font-family: 'Helvetica'; font-size: 11pt; text-align: justify;">
                        <!-- Identification des Parties -->
                        <!-- 1. AFFICHAGE DE L'EN-TETE EDITE -->
                        <div class="mb-4">
                            <t t-out="doc.header_content"/>
                        </div>

                        <!-- Debut test boucle pour articles -->
                        <t t-foreach="doc.article_ids" t-as="art">
                            <!-- Titre avec soulignement dynamique -->
                            <h6 class="mt-4 mb-2" style="font-weight: bold;">
                                <span class="text-dark border-bottom border-dark pb-1" t-esc="art.name"/>
                            </h6>

                            <!-- Contenu de l'article (Le texte du CDATA) -->
                            <div class="ps-3 small text-justify">
                                <t t-out="art.content"/>
                            </div>

                            <!--                            &lt;!&ndash; Ajout dynamique SI l'article est l'Objet (Exemple) &ndash;&gt;-->
                            <!--                            <p t-if="'Objet' in art.name" class="ps-3 small">-->
                            <!--                                Partenaire concerné :-->
                            <!--                                <strong>-->
                            <!--                                    <span t-field="doc.partner_id.name"/>-->
                            <!--                                </strong>-->
                            <!--                            </p>-->
                        </t>
                        <!-- fin test boucle articles -->

                        <!-- Zone de Signature -->
                        <div class="row mt-5" style="page-break-inside: avoid;">
                            <div class="col-6 text-center">
                                <strong>
                                    <u>Pour Le PARTENAIRE</u>
                                </strong>
                                <br/>
                                <br/>
                                <p>...........................</p>
                                <br/>
                                <br/>
                                <p>Le ........................</p>
                                <br/>
                                <br/>
                                <p>Date: ........................</p>
                            </div>
                            <div class="col-6 text-center">
                                <strong>Pour GAINDE 2000</strong>
                                <br/>
                                <br/>
                                <p>Ibrahima Nour Eddine DIAGNE</p>
                                <br/>
                                <br/>
                                <p>L’Administrateur Général</p>
                                <br/>
                                <br/>
                                <p>Date: ........................</p>
                            </div>
                        </div>

                    </div>

                    <div class="footer"
                         style="border-top: 1px solid #ccc; font-size: 8pt; text-align: center; color: #666;">
                        <br/>
                        Page
                        <span class="page"/>
                        /
                        <span class="topage"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
