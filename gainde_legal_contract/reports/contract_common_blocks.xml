<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_contract_identification_header">
        <!-- Tableau d'identification stylisé -->
        <div style="border: 1px solid black; padding: 0; margin-bottom: 30px; font-size: 10pt;">
            <div style="background-color: #f2f2f2; border-bottom: 1px solid black; padding: 5px; font-weight: bold;">
                IDENTIFICATION
            </div>
            <table class="table table-sm table-bordered" style="margin-bottom: 0;">
                <tr>
                    <td style="width: 30%; background-color: #f9f9f9;"><strong>Titre</strong></td>
                    <td style="width: 70%;"><span t-field="doc.type_id.name"/></td>
                </tr>
                <tr>
                    <td style="background-color: #f9f9f9;"><strong>Objet</strong></td>
                    <td><span t-field="doc.type_id.description"/></td>
                </tr>
                <tr>
                    <td style="background-color: #f9f9f9;"><strong><t t-esc="doc.partner_role"/></strong></td>
                    <td><span t-field="doc.partner_id.name"/></td>
                </tr>
                <tr>
                    <td style="background-color: #f9f9f9;"><strong>Version</strong></td>
                    <td><span t-field="doc.version_sequence or '1.0'"/></td>
                </tr>
                <tr>
                    <td style="background-color: #f9f9f9;"><strong>Rédacteur(s)</strong></td>
                    <td><span t-field="doc.create_uid.name"/></td>
                </tr>
                <tr>
                    <td style="background-color: #f9f9f9;"><strong>Date de signature</strong></td>
                    <td><span t-field="doc.date_start" t-options='{"widget": "date"}'/></td>
                </tr>
                <tr>
                    <td style="background-color: #f9f9f9;"><strong>Référence</strong></td>
                    <td><span t-field="doc.name"/></td>
                </tr>
                <tr>
                    <td style="background-color: #f9f9f9;"><strong>Diffusion</strong></td>
                    <td>Restreinte</td>
                </tr>
                <tr>
                    <td style="background-color: #f9f9f9;"><strong>Durée</strong></td>
                    <td><span t-field="doc.duration_text or '...'"/></td>
                </tr>
            </table>

            <div style="padding: 10px; border-top: 1px solid black;">
                <strong>ACTIVITÉ / SECTEUR</strong><br/>
                <span t-field="doc.activity_sector or 'Rémunérations d’intermédiaires et de conseils'"/>
            </div>

            <div style="padding: 10px; border-top: 1px solid black; min-height: 60px;">
                <strong>COMMENTAIRES</strong><br/>
                <span t-field="doc.commentaires_ged"/>
            </div>
        </div>
    </template>
</odoo>
