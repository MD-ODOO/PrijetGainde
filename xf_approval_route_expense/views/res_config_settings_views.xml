<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_expense_approval_route" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.expense.approval.route</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="25"/>
        <field name="inherit_id" ref="hr_expense.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="expenses_setting_container" position="inside">
                <setting id="use_approval_route_expense"
                         title="Use Dynamic Approval Route for Expense Reports. Values set here are company-specific."
                         help="Use Dynamic Approval Route for Expense Reports. Values set here are company-specific.">
                    <field name="use_approval_route_expense" class="o_light_label" widget="radio"/>
                </setting>
            </block>
        </field>
    </record>

</odoo>
