<odoo>
    <data>

        <record id="view_cerco_request_medical_form" model="ir.ui.view">
            <field name="name">cerco.request.medical.form</field>
            <field name="model">cerco.request.medical</field>
            <field name="arch" type="xml">
                <form string="Demande de prise en charge médicale">
                    <header>
                        <button name="action_submit" string="Soumettre" states="draft" type="object" icon="fa-arrow-right"/>
                        <button name="open_wizard_approbation" string="Approuver" type="object" class="oe_highlight" states="submit" groups="base.group_hr_manager"/>
                        <button name="open_wizard_refusal" string="Rejeter" type="object" class="oe_highlight"  attrs="{'invisible': [('state','!=', 'submit')]}" groups="base.group_hr_manager"/>
                        <button name="action_close" string="Clôturer" type="object" class="oe_highlight" states="validate"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submit,validate"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <label for="employee_id"/>
                            <h1><field name="employee_id" attrs="{'readonly':[('state','!=','draft')]}"/></h1>
                        </div>

                        <group>
                            <field name="date" attrs="{'readonly':[('state','!=','draft')]}"/>
                            <field name="close_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="type" attrs="{'readonly':[('state','!=','draft')]}"/>
                        </group>

                        <group>
                            <field name="comment" placeholder="Note ici..." attrs="{'readonly':[('state','!=','draft')]}"/>
                        </group>

                        <group string="Historique des approbations">
                            <field name="approvers" nolabel="1" readonly="1">
                                <tree editable="top">
                                    <field name="user_id"/>
                                    <field name="date_approved"/>
                                    <field name="comment"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>

                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>

                </form>
            </field>
        </record>

    </data>
</odoo>
