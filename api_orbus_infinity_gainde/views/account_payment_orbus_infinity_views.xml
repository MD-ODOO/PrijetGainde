<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Extension du formulaire de paiement pour Orbus Infinity -->
        <record id="view_account_payment_form_orbus_infinity" model="ir.ui.view">
            <field name="name">account.payment.form.orbus.infinity</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <!-- Masquer le type de paiement standard et le journal pour les paiements Orbus -->
                <xpath expr="//group[@name='group1']/field[@name='payment_type']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//group[@name='group2']/field[@name='journal_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- Référence panier Orbus Infinity, sous le type de paiement Orbus -->
                <xpath expr="//group[@name='group1']/field[@name='orbus_payment_type']" position="after">
                    <field name="orbus_infinity_reference_panier" invisible="orbus_payment_type != 'infinity'"/>
                </xpath>

                <!-- Aucun bouton spécifique Infinity : le bouton standard "Confirm"
                     (action_post) gère désormais les appels à l'API Orbus Infinity. -->
            </field>
        </record>
    </data>
</odoo>
