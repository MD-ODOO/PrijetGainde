<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_tier_account" model="ir.ui.view">
        <field name="name">account.move.form.tier.account</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']//field[@name='partner_id']" position="after">
                <label for="entry_sequence" string="Numéro de saisie"/>
                <div class="o_row">
                    <field name="entry_sequence" readonly="1"/>
                </div>
            </xpath>

            <xpath expr="//page[@id='aml_tab']//field[@name='line_ids']/list/field[@name='partner_id']" position="after">
                <field name="tier_account"
                       string="Compte tiers"
                       optional="show"
                       widget="badge"
                       decoration-info="tier_account"
                       invisible="account_type not in ('asset_receivable', 'liability_payable')"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_tree_tier_account" model="ir.ui.view">
        <field name="name">account.move.line.tree.tier.account</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='account_id']" position="after">
                <field name="tier_account"
                       string="Compte tiers"
                       optional="hide"
                       widget="badge"
                       decoration-info="tier_account"
                       invisible="account_type not in ('asset_receivable', 'liability_payable')"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_tier_account" model="ir.ui.view">
        <field name="name">account.move.list.tier.account</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='name']" position="after">
                <field name="entry_sequence" string="Numéro de saisie" optional="show"/>
            </xpath>
            <xpath expr="//list/field[@name='partner_id']" position="after">
                <field name="tier_account" string="Compte tiers" optional="show" widget="badge" decoration-info="tier_account"/>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_tier_account" model="ir.ui.view">
        <field name="name">account.invoice.list.tier.account</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='name']" position="after">
                <field name="entry_sequence" string="Numéro de saisie" optional="show"/>
            </xpath>
            <xpath expr="//list/field[@name='invoice_partner_display_name'][last()]" position="after">
                <field name="tier_account" string="Compte tiers" optional="show" widget="badge" decoration-info="tier_account"/>
            </xpath>
        </field>
    </record>

</odoo>
