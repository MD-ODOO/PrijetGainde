<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Restreindre l'annuaire des utilisateurs aux administrateurs système -->
        <record id="base.action_res_users" model="ir.actions.act_window">
            <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
        </record>
        <record id="base.menu_action_res_users" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
        </record>
        <record id="base.menu_users" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
        </record>

        <!-- Set default search for Purchase Orders (my approvals) -->
        <record id="purchase.purchase_rfq" model="ir.actions.act_window">
            <field name="context">{'search_default_my_approvals': 1}</field>
        </record>

        <!-- Set default search for Purchase Orders - Bons de commande (my approvals) -->
        <record id="purchase.purchase_form_action" model="ir.actions.act_window">
            <field name="context">{'search_default_my_approvals': 1}</field>
        </record>

        <!-- Set default search for Purchase Requests (my approvals) -->
        <record id="purchase_request.purchase_request_form_action" model="ir.actions.act_window">
            <field name="context">{'search_default_my_approvals': 1}</field>
        </record>

        <!-- Set default search for Purchase Request Lines (my approvals) -->
        <record id="purchase_request.purchase_request_line_form_action" model="ir.actions.act_window">
            <field name="context">{'search_default_my_approvals': 1}</field>
        </record>

    </data>
</odoo>
