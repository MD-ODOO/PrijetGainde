             On met un approbateur placeholder pour satisfaire la contrainte
            <field name="custom_user_ids" eval="[(4, ref('base.user_root'))]"/>
        </record> -->

        <!-- Étape 2: Responsable comptable -->
        <record id="xf_stage_partner_account_manager" model="approval.route.stage">
            <field name="name">Approbation Service comptable</field>
            <field name="sequence">1</field>
            <field name="approval_type">one</field>
            <field name="use_custom_conditions" eval="False"/>
            <field name="approval_route_id" ref="xf_route_res_partner_default"/>
            <field name="approval_role_id" ref="purchase_gainde.approval_role_account_manager_gainde"/>
        </record>

        <!-- Route d'approbation par défaut pour les articles -->
        <record id="xf_route_product_template_default" model="approval.route">
            <field name="name">Route par défaut - Articles</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Étape 1: RA Achats pour article (responsable achats initie) -->
        <!-- <record id="xf_stage_product_ra" model="approval.route.stage">
            <field name="name">Approbation RA Achats</field>
            <field name="sequence">1</field>
            <field name="approval_type">one</field>
            <field name="use_custom_conditions" eval="False"/>
            <field name="approval_route_id" ref="xf_route_product_template_default"/>
            <field name="custom_user_ids" eval="[(4, ref('base.user_root'))]"/>
        </record> -->

        <!-- Étape 2: Contrôleur article (vérifie existence / poste budgétaire) -->
        <record id="xf_stage_product_controller" model="approval.route.stage">
            <field name="name">Contrôle RCG</field>
            <field name="sequence">1</field>
            <field name="approval_type">one</field>
            <field name="use_custom_conditions" eval="False"/>
            <field name="approval_route_id" ref="xf_route_product_template_default"/>
            <field name="approval_role_id" ref="purchase_gainde.approval_role_product_controller_gainde"/>
        </record>

        <!-- Étape 3: Responsable comptable pour article (renseigne compte tiers) -->
        <record id="xf_stage_product_account_manager" model="approval.route.stage">
            <field name="name">Approbation Service comptable</field>
            <field name="sequence">2</field>
            <field name="approval_type">one</field>
            <field name="use_custom_conditions" eval="False"/>
            <field name="approval_route_id" ref="xf_route_product_template_default"/>
