<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ajout du champ "Code analytique" dans la liste des lignes de budget -->
    <record id="view_budget_line_tree_inherit_gainde" model="ir.ui.view">
        <field name="name">budget.line.list.inherit.gainde</field>
        <field name="model">budget.line</field>
        <field name="inherit_id" ref="account_budget.view_budget_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_id']" position="before">
                <field name="analytic_code" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Ajout du champ "Code analytique" dans le formulaire des lignes de budget -->
    <record id="view_budget_line_form_inherit_gainde" model="ir.ui.view">
        <field name="name">budget.line.form.inherit.gainde</field>
        <field name="model">budget.line</field>
        <field name="inherit_id" ref="account_budget.view_budget_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_id']" position="after">
                <field name="analytic_code"/>
            </xpath>
        </field>
    </record>

</odoo>
