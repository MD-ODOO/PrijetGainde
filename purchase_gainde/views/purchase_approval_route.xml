        <!-- Inherit purchase.order approval form from xf_approval_route_purchase
             to hide approval_route_id (we map it automatically in Python) -->
        <record id="purchase_order_approval_form_inherit_gainde" model="ir.ui.view">
            <field name="name">purchase.order.approval.form.inherit.gainde</field>
            <field name="inherit_id" ref="xf_approval_route_purchase.purchase_order_approval_form"/>
            <field name="model">purchase.order</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='approval_route_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                    <attribute name="required">0</attribute>
                </xpath>

                <!-- Restreindre l'affichage des étapes aux étapes en attente / futures
                     et marquer l'édition des approbateurs avec un context spécifique
                     pour pouvoir contrôler/ notifier côté Python. -->
                <xpath expr="//page[@name='approval_route']/field[@name='approval_route_stage_ids']" position="replace">
                    <field name="approval_route_stage_ids"
                >
                        <list>
                            <field name="sequence" invisible="True" widget="handle"/>
                            <field name="name" readonly="1"/>
                            <field name="user_ids" widget="many2many_avatar_user"/>
                            <field name="state" readonly="1"/>
                            <field name="decisions_summary" readonly="1"/>
                        </list>
                    </field>
                </xpath>
            </field>
        </record>

        <!-- Inherit purchase.request.line form to add approval route panel -->
        <record id="purchase_request_line_approval_form" model="ir.ui.view">
            <field name="name">purchase.request.line.approval.form</field>
            <field name="inherit_id" ref="purchase_request.purchase_request_line_form"/>
            <field name="model">purchase.request.line</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='analytic_distribution']" position="attributes">
                    <attribute name="readonly">not can_edit_analytic_distribution</attribute>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page name="approval_route" string="Parcours d'approbation"
                          invisible="approval_route_id == False">
                        <field name="approval_route_id" string="Parcours d'approbation" />
                        <field name="approval_route_stage_ids" widget="one2many_list">
                            <list>
                                <field name="sequence" invisible="1"/>
                                <field name="name" string="Étapes"/>
                                <field name="user_ids" widget="many2many_avatar_user" string="Approvers"/>
                            </list>
                        </field>
                    </page>
                </xpath>

                <!-- Masquer les onglets "Purchase Order Lines" et "Allocations" sur la ligne de demande d'achat -->
                <xpath expr="//page[@name='purchase_lines']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page[@name='allocations']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <!-- Override: rendre approval_route_stage_ids toujours en readonly sur la vue d'approbation PO -->
        <record id="purchase_order_approval_form_inherit_gainde_readonly" model="ir.ui.view">
            <field name="name">purchase.order.approval.form.inherit.gainde.readonly</field>
            <field name="inherit_id" ref="purchase_gainde.purchase_order_approval_form_inherit_gainde"/>
            <field name="model">purchase.order</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='approval_route_stage_ids']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
            </field>
        </record>

        <!-- Override: rendre approval_route_stage_ids toujours en readonly sur la vue d'approbation PR line -->
        <record id="purchase_request_line_approval_form_readonly" model="ir.ui.view">
            <field name="name">purchase.request.line.approval.form.readonly</field>
            <field name="inherit_id" ref="purchase_gainde.purchase_request_line_approval_form"/>
            <field name="model">purchase.request.line</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='approval_route_stage_ids']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>