    <xpath expr="//div[div[@t-esc='purchase_request.description']]/label" position="replace">
                        <label class="col-form-label fw-bold">Objet</label>
        </xpath>
         <!-- Add State column after UoM -->
        <xpath expr="//t[@t-foreach]/tr/td[last()]" position="after">
            <td class="text-center">
                <span
                    t-field="line.state"
                    t-attf-class="
                        badge rounded-pill
                        #{'text-bg-danger' if line.state == 'rejected'
                        else 'text-bg-success' if line.state == 'approved'
                        else 'text-bg-info'}
                    "
                />
            </td>
        </xpath>

    </template>

    <!-- Liste des demandes : renommer la colonne "Description" en "Objet" -->
    <template id="portal_my_purchase_requests_gainde" inherit_id="bf_portal_purchase_request.portal_my_purchase_requests">
        <xpath expr="//thead//th[hasclass('text-end') and hasclass('d-none') and hasclass('d-md-table-cell') and normalize-space()='Description']" position="replace">
            <th class="text-end d-none d-md-table-cell">Objet</th>
        </xpath>

        <!-- Ajouter le label "Nouveau" après l'icône + sur le bouton de création -->
        <xpath expr="//p[hasclass('d-inline-flex') and hasclass('gap-1')]/a[i[hasclass('fa-plus')]]" position="replace">
            <a href="/my/purchase_requests/new" class="btn btn-primary" aria-label="Edit">
                <i class="fa fa-plus fa-1g float-sm-none float-md-start" title="Edit"></i>
                <span>Créer une demande</span>
            </a>
        </xpath>
    </template>

    <!-- Fix AccessError on res.currency in web.frontend_layout by using sudo -->
    <template id="web_frontend_layout_gainde_fix_currency" inherit_id="web.frontend_layout">
        <xpath expr="//t[contains(@t-out, 'get_frontend_session_info')]" position="replace">
            <t t-out="json.dumps(request.env['ir.http'].sudo().get_frontend_session_info())"/>
        </xpath>
    </template>
