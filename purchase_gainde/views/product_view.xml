<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_category_form_view_inherit_user_profile"
            model="ir.ui.view">
        <field name="name">product.category.form.inherit.user.profile</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">

            <!-- Insert after parent category -->
            <xpath expr="//group[@name='first']/field[@name='parent_id']"
                   position="after">
                <field name="user_profile_id"/>
            </xpath>

        </field>
    </record>
 <record id="product_template_form_view_inherit_post_id"
            model="ir.ui.view">
        <field name="name">product.template.form.inherit.post.id</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <!-- Add post_id AFTER barcode, with dynamic required/readonly on approval step 1 -->
            <xpath expr="//field[@name='barcode']" position="after">
                            <field name="post_id" required="current_approval_stage_id and current_approval_stage_id.sequence == 1" readonly="current_approval_stage_id and  (not is_current_approver and  current_approval_stage_id.sequence == 1)"/>

                <!-- <field name="post_id"
                       required="current_approval_stage_id and current_approval_stage_id.sequence == 1"
                       readonly="current_approval_stage_id and not (is_current_approver and current_approval_stage_id.sequence == 1)"/> -->
            </xpath>

        </field>
    </record>
</odoo>
