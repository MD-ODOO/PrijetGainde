<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_inherit_center_id"
            model="ir.ui.view">
        <field name="name">product.template.form.inherit.center.id</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <!-- Ajouter center_id juste après post_id, visible uniquement si sale_ok est coché -->
            <xpath expr="//field[@name='post_id']" position="after">
                <field name="center_id" invisible="not sale_ok"/>
            </xpath>

        </field>
    </record>

</odoo>
