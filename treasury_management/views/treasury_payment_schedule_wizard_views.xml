<odoo>
  <record id="view_treasury_payment_schedule_wizard_form" model="ir.ui.view">
    <field name="model">treasury.payment.schedule.wizard</field>
    <field name="arch" type="xml">
      <form string="Programmer un décaissement">
        <group>
          <group string="Facture">
            <field name="invoice_id"/>
            <field name="partner_id" readonly="1"/>
          </group>
          <group string="Planification">
            <field name="planned_payment_date" required="1"/>
            <field name="priority" widget="priority"/>
            <field name="payment_channel"/>
            <field name="category_id"/>
          </group>
        </group>
        <group string="Instructions">
          <field name="instructions" nolabel="1"
                 placeholder="Instructions pour la caisse / banque (optionnel)"/>
        </group>
        <footer>
          <button string="Programmer" type="object" name="action_schedule" class="btn-primary"/>
          <button string="Annuler" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
