<odoo>
  <record id="view_treasury_payment_plan_wizard_form" model="ir.ui.view">
    <field name="model">treasury.payment.plan.wizard</field>
    <field name="arch" type="xml">
      <form string="Programmer les décaissements sélectionnés">
        <field name="payment_ids" invisible="1"/>
        <group>
          <group string="Planification">
            <field name="planned_payment_date" required="1"/>
            <field name="priority" widget="priority"/>
          </group>
          <group string="Paiement">
            <field name="payment_channel"/>
            <field name="journal_id"/>
          </group>
        </group>
        <group string="Instructions">
          <field name="instructions" nolabel="1"
                 placeholder="Instructions pour la caisse / banque (optionnel)"/>
        </group>
        <footer>
          <button string="Appliquer" type="object" name="action_apply" class="btn-primary"/>
          <button string="Annuler" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
