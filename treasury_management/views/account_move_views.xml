<odoo>
  <record id="view_account_move_treasury_btn" model="ir.ui.view">
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_schedule_treasury_payment" type="object"
          string="Programmer décaissement"
          groups="treasury_management.group_treasury_df"
          invisible="move_type != 'in_invoice'"/>
      </xpath>
    </field>
  </record>
</odoo>
