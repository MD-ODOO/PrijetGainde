<odoo>
  <record id="action_treasury_invoice_paid_out" model="ir.actions.act_window">
    <field name="name">Factures encaissées</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="domain">[("move_type", "=", "out_invoice"), ("payment_state", "=", "paid")]</field>
    <field name="context">{'default_move_type': 'out_invoice', 'search_default_posted': 1}</field>
  </record>

  <record id="action_treasury_invoice_unpaid_out" model="ir.actions.act_window">
    <field name="name">Factures non encaissées</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="domain">[("move_type", "=", "out_invoice"), ("payment_state", "in", ["not_paid", "partial"])]</field>
    <field name="context">{'default_move_type': 'out_invoice', 'search_default_posted': 1}</field>
  </record>

  <record id="action_treasury_bill_paid_in" model="ir.actions.act_window">
    <field name="name">Factures réglées</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="domain">[("move_type", "=", "in_invoice"), ("payment_state", "=", "paid")]</field>
    <field name="context">{'default_move_type': 'in_invoice', 'search_default_posted': 1}</field>
  </record>

  <record id="action_treasury_bill_unpaid_in" model="ir.actions.act_window">
    <field name="name">Factures non réglées</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="domain">[("move_type", "=", "in_invoice"), ("payment_state", "in", ["not_paid", "partial"])]</field>
    <field name="context">{'default_move_type': 'in_invoice', 'search_default_posted': 1}</field>
  </record>

  <record id="action_treasury_payment_inbound" model="ir.actions.act_window">
    <field name="name">Paiements entrants</field>
    <field name="res_model">account.payment</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="domain">[("payment_type", "=", "inbound"), ("state", "=", "paid")]</field>
    <field name="context">{'default_payment_type': 'inbound', 'search_default_posted': 1}</field>
  </record>

  <record id="action_treasury_payment_outbound" model="ir.actions.act_window">
    <field name="name">Paiements sortants</field>
    <field name="res_model">account.payment</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="domain">[("payment_type", "=", "outbound"), ("state", "=", "paid")]</field>
    <field name="context">{'default_payment_type': 'outbound', 'search_default_posted': 1}</field>
  </record>
</odoo>
