<odoo>
  <record id="action_treasury_invoice_template" model="ir.actions.act_window">
    <field name="name">Modèles de factures</field>
    <field name="res_model">treasury.invoice.template</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_treasury_invoice_template_list" model="ir.ui.view">
    <field name="model">treasury.invoice.template</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="journal_id"/>
        <field name="payment_term_id"/>
      </list>
    </field>
  </record>

  <record id="view_treasury_invoice_template_form" model="ir.ui.view">
    <field name="model">treasury.invoice.template</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_create_invoice" type="object" string="Créer facture" class="btn-primary"/>
        </header>
        <sheet>
          <group>
            <field name="name"/>
            <field name="partner_id"/>
            <field name="journal_id"/>
            <field name="payment_term_id"/>
          </group>
          <notebook>
            <page string="Lignes">
              <field name="line_ids">
                <list editable="bottom">
                  <field name="product_id"/>
                  <field name="name"/>
                  <field name="quantity"/>
                  <field name="price_unit"/>
                  <field name="tax_ids" widget="many2many_tags"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
