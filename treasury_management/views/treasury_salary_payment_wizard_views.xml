<odoo>
  <record id="view_treasury_salary_payment_wizard" model="ir.ui.view">
    <field name="name">treasury.salary.payment.wizard.form</field>
    <field name="model">treasury.salary.payment.wizard</field>
    <field name="arch" type="xml">
      <form string="Paiement de salaire" create="false" edit="false">
        <group>
          <group>
            <field name="employee_id" options="{'no_open': True}"/>
            <field name="partner_id" readonly="1"/>
            <field name="responsible_user_id"/>
          </group>
          <group>
            <field name="amount"/>
            <field name="currency_id"/>
            <field name="payment_date"/>
            <field name="planned_payment_date"/>
          </group>
        </group>
        <group>
          <group>
            <field name="payment_channel"/>
            <field name="journal_id" domain="[]" required="1"/>
          </group>
          <group>
            <field name="note" placeholder="Message ou instructions pour la comptabilité" nolabel="1"/>
          </group>
        </group>
        <footer>
          <button string="Annuler" class="btn-secondary" special="cancel"/>
          <button name="action_confirm" type="object" string="Créer le paiement" class="btn-primary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_treasury_salary_payment_wizard" model="ir.actions.act_window">
    <field name="name">Paiement salaires</field>
    <field name="res_model">treasury.salary.payment.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
