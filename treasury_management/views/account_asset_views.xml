<odoo>
  <record id="view_account_asset_form_compte_tiers_treasury" model="ir.ui.view">
    <field name="name">account.asset.form.compte.tiers.treasury</field>
    <field name="model">account.asset</field>
    <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
    <field name="arch" type="xml">
      <xpath expr="(//field[@name='x_studio_compte_auxiliaire'] | //group[@name='asset_values']/field[@name='asset_group_id'])[1]" position="after">
        <field name="compte_tiers"/>
      </xpath>
    </field>
  </record>

  <record id="view_account_asset_tree_compte_tiers_treasury" model="ir.ui.view">
    <field name="name">account.asset.tree.compte.tiers.treasury</field>
    <field name="model">account.asset</field>
    <field name="inherit_id" ref="account_asset.view_account_asset_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='x_studio_compte_auxiliaire'] | //field[@name='name' and not(//field[@name='x_studio_compte_auxiliaire'])]" position="after">
        <field name="compte_tiers"/>
      </xpath>
    </field>
  </record>
</odoo>
