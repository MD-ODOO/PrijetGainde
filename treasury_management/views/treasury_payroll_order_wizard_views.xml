<odoo>
  <record id="view_treasury_payroll_order_wizard" model="ir.ui.view">
    <field name="name">treasury.payroll.order.wizard.form</field>
    <field name="model">treasury.payroll.order.wizard</field>
    <field name="arch" type="xml">
      <form string="Ordre de décaissement paie">
        <group>
          <group>
            <field name="batch_id" readonly="1"/>
            <field name="payment_date"/>
            <field name="payment_channel"/>
          </group>
          <group>
            <field name="partner_id" required="1"/>
            <field name="journal_id" required="1"/>
          </group>
        </group>
        <group>
          <field name="note" placeholder="Instructions pour la trésorerie / banque" nolabel="1"/>
        </group>
        <footer>
          <button string="Annuler" class="btn-secondary" special="cancel"/>
          <button name="action_create" type="object" string="Créer l'ordre" class="btn-primary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
