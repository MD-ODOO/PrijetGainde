<odoo>
  <record id="view_treasury_forecast_generate_wizard" model="ir.ui.view">
    <field name="model">treasury.forecast.generate.wizard</field>
    <field name="arch" type="xml">
      <form string="Générer des prévisions">
        <group>
          <field name="start_date"/>
          <field name="end_date"/>
          <field name="period_type"/>
        </group>
        <footer>
          <button string="Générer" type="object" name="action_generate" class="btn-primary"/>
          <button string="Annuler" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_treasury_forecast_generate" model="ir.actions.act_window">
    <field name="name">Générer prévisions</field>
    <field name="res_model">treasury.forecast.generate.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="groups_id" eval="[(4, ref('treasury_management.group_treasury_df'))]"/>
  </record>
</odoo>
