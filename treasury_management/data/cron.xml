<odoo>
  <record id="ir_cron_treasury_forecast_alert" model="ir.cron">
    <field name="name">Alerte trésorerie</field>
    <field name="model_id" ref="treasury_management.model_treasury_forecast"/>
    <field name="state">code</field>
    <field name="code">model._cron_treasury_forecast_alert()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active">True</field>
  </record>

  <record id="ir_cron_treasury_overdue_alerts" model="ir.cron">
    <field name="name">Alertes retards trésorerie</field>
    <field name="model_id" ref="treasury_management.model_treasury_payment"/>
    <field name="state">code</field>
    <field name="code">model._cron_treasury_overdue_alerts()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active">True</field>
  </record>

  <record id="ir_cron_treasury_invoice_reminders" model="ir.cron">
    <field name="name">Relances factures</field>
    <field name="model_id" ref="account.model_account_move"/>
    <field name="state">code</field>
    <field name="code">model._cron_treasury_invoice_reminders()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active">True</field>
  </record>
</odoo>
