<odoo>
  <!-- Define all groups first without implied_ids -->
  <record id="group_treasury_cashier" model="res.groups">
    <field name="name">Caisse Trésorerie</field>
    <field name="category_id" ref="base.module_category_accounting"/>
  </record>
  <record id="group_treasury_manager" model="res.groups">
    <field name="name">Manager Trésorerie</field>
    <field name="category_id" ref="base.module_category_accounting"/>
  </record>
  <record id="group_treasury_df" model="res.groups">
    <field name="name">Direction Financière</field>
    <field name="category_id" ref="base.module_category_accounting"/>
  </record>
  <!-- Set implied_ids after all groups exist in the database -->
  <record id="group_treasury_manager" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('treasury_management.group_treasury_cashier'))]"/>
  </record>
  <record id="group_treasury_df" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('treasury_management.group_treasury_manager')), (4, ref('treasury_management.group_treasury_cashier'))]"/>
  </record>
</odoo>
