<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="treasury_management.TreasuryKpiDashboardV2">
    <div class="o_treasury_kpi_dashboard o_form_view o_xxl" style="background:#f6f8fb; padding:16px;">

        <!-- Header -->
        <div class="o_card o_px_3 o_py_3" style="border:1px solid #e6e9f0; box-shadow:0 4px 10px rgba(15,23,42,0.06); background:#fff;">
            <div class="o_row o_align_items_center o_justify_content_between o_mb_3 o_filter_bar">
                <div>
                    <h2 class="o_mb_0">Tableau de bord</h2>
                    <div class="text-muted">Trésorerie</div>
                </div>
                <div class="o_row o_gap_2">
                    <div>
                        <label class="text-muted">Période</label>
                        <select class="o_input" style="min-width:140px" t-att-value="state.period" t-on-change="onPeriodChange">
                            <option value="last">Année dernière</option>
                            <option value="current">Année en cours</option>
                            <option value="custom">Personnalisée</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-muted">Année</label>
                        <input type="number" class="o_input" style="width:110px"
                               t-att-value="state.year"
                               t-att-readonly="state.period != 'custom' ? true : undefined"
                               t-on-change="onYearChange"/>
                    </div>
                    <div>
                        <label class="text-muted">Type de flux</label>
                        <select class="o_input" style="min-width:160px" t-att-value="state.view" t-on-change="onViewChange">
                            <option value="all">Tous</option>
                            <option value="receipts">Encaissements</option>
                            <option value="payments">Décaissements</option>
                        </select>
                    </div>
                </div>
            </div>

            <t t-if="state.loading">
                <div class="o_text_center o_py_4">
                    <i class="fa fa-spinner fa-spin me-2"/> Chargement…
                </div>
            </t>

            <t t-if="!state.loading">
                <!-- Cards -->
                <div class="o_row o_gap_3 o_flex_wrap">
                    <t t-foreach="cards" t-as="c" t-key="c.key">
                        <div class="o_card o_px_4 o_py_3" style="flex:1; min-width:260px; border:1px solid #e6e9f0; box-shadow:0 3px 9px rgba(15,23,42,0.05);">
                            <div class="text-muted o_mb_1" t-esc="c.label"/>
                            <div style="font-size:32px; font-weight:800; color:#1f2d3d" t-esc="formatCurrency(c.value)"/>
                            <div class="text-success" t-if="c.note" t-esc="c.note"/>
                        </div>
                    </t>
                </div>

                <!-- Tracking -->
                <div class="o_card o_px_4 o_py_3 o_mt_3" style="border:1px solid #e6e9f0; box-shadow:0 4px 12px rgba(15,23,42,0.06);">
                    <h4 class="o_mb_3">Suivi des décaissements</h4>
                    <div class="o_row o_gap_3">
                        <div class="o_col-4 o_card o_px_3 o_py_3" style="background:#e8f6ef;border:1px solid #d2ecde; box-shadow:none;">
                            <div class="text-success" style="font-size:28px; font-weight:700" t-esc="paymentTracking.paid"/>
                            <div class="text-success">Payés</div>
                        </div>
                        <div class="o_col-4 o_card o_px_3 o_py_3" style="background:#fff6e5;border:1px solid #ffe3b8; box-shadow:none;">
                            <div style="color:#d48b00;font-size:28px;font-weight:700" t-esc="paymentTracking.pending"/>
                            <div style="color:#d48b00">En attente</div>
                        </div>
                        <div class="o_col-4 o_card o_px_3 o_py_3" style="background:#fde8e8;border:1px solid #f4c7c7; box-shadow:none;">
                            <div class="text-danger" style="font-size:28px; font-weight:700" t-esc="paymentTracking.overdue"/>
                            <div class="text-danger">En retard</div>
                        </div>
                    </div>
                    <div class="progress o_mt_3" style="height:14px;">
                        <div class="progress-bar bg-success"
                             role="progressbar"
                             t-att-style="`width:${paymentTracking.progress}%;`"
                             t-att-aria-valuenow="paymentTracking.progress"
                             aria-valuemin="0" aria-valuemax="100"/>
                    </div>
                    <div class="text-end text-muted o_mt_1" t-esc="paymentTracking.progress + '%'"/>
                </div>

                <!-- Latest -->
                <div class="o_card o_px_4 o_py_3 o_mt_3" style="border:1px solid #e6e9f0; box-shadow:0 4px 12px rgba(15,23,42,0.06);">
                    <h4>Derniers mouvements</h4>
                    <p class="text-muted o_mb_0">Aucun mouvement récent.</p>
                </div>
            </t>
        </div>
    </div>
</t>

</templates>
