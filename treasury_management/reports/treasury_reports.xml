  />

  <record id="treasury_payment_voucher_report" model="ir.actions.report">
    <field name="name">Bon de paiement</field>
    <field name="model">treasury.payment</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">treasury_management.treasury_payment_voucher_template</field>
    <field name="report_file">treasury_management.treasury_payment_voucher_template</field>
    <field name="binding_model_id" ref="model_treasury_payment"/>
    <field name="binding_type">report</field>
    <field name="print_report_name">'Bon de paiement - %s' % (object.name or '')</field>
  </record>

