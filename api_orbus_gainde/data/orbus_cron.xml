<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron pour importer périodiquement les batches de factures Orbus -->
        <record id="ir_cron_orbus_factures_batch" model="ir.cron">
            <field name="name">Orbus - Import factures par periode</field>
            <field name="model_id" ref="model_orbus_api_config"/>
            <field name="state">code</field>
            <field name="code">model.cron_fetch_factures_batch_next_periode()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active">False</field>
        </record>
    </data>
</odoo>
