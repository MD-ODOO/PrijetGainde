<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Vue liste des batches de factures Orbus -->
        <record id="view_orbus_facture_batch_list" model="ir.ui.view">
            <field name="name">orbus.facture.batch.list</field>
            <field name="model">orbus.facture.batch</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="periode"/>
                    <field name="status_code"/>
                    <field name="status"/>
                    <field name="request_date"/>
                    <field name="company_id"/>
                </list>
            </field>
        </record>

        <!-- Vue formulaire des batches de factures Orbus -->
        <record id="view_orbus_facture_batch_form" model="ir.ui.view">
            <field name="name">orbus.facture.batch.form</field>
            <field name="model">orbus.facture.batch</field>
            <field name="arch" type="xml">
                <form string="Lot de factures Orbus">
                    <header>
                        <button name="action_create_invoices" type="object"
                                string="Creer les factures Odoo"
                                class="btn-primary"/>
                        <button name="action_delete_lines" type="object"
                            string="Supprimer toutes les lignes"
                            class="btn-secondary"
                            confirm="Supprimer toutes les lignes de ce batch ?"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="periode"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Métadonnées">
                            <field name="status_code"/>
                            <field name="status"/>
                            <field name="message"/>
                            <field name="request_date"/>
                            <field name="params_json" widget="text"/>
                        </group>
                        <group string="Synthèse API" colspan="2">
                            <div style="max-height:200px; overflow:auto;">
                                <field name="api_summary_html" widget="html" nolabel="1" readonly="1"/>
                            </div>
                        </group>
                        <notebook>
                            <page string="Factures">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="numero_facture"/>
                                        <field name="numero_client"/>
                                        <field name="nom_client"/>
                                        <field name="montant_ht"/>
                                        <field name="montant_ttc"/>
                                        <field name="montant_tva"/>
                                        <field name="montant_taxe_18"/>
                                        <field name="montant_taxable"/>
                                        <field name="montant_non_taxable" string="Montant exonéré"/>
                                        <field name="devise"/>
                                        <field name="state"/>
                                        <field name="invoice_id"/>
                                        <field name="error_message"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action liste des batches -->
        <record id="action_orbus_facture_batch" model="ir.actions.act_window">
            <field name="name">Lots de factures Orbus</field>
            <field name="res_model">orbus.facture.batch</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu sous Orbus API -->
        <menuitem id="menu_orbus_facture_batch"
                  name="Lots de factures Orbus"
                  parent="menu_orbus_api_config_root"
                  action="action_orbus_facture_batch"
                  sequence="10"/>
    </data>
</odoo>
