<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Vue formulaire du wizard de creation de facture Orbus -->
        <record id="view_orbus_create_invoice_wizard_form" model="ir.ui.view">
            <field name="name">orbus.create.invoice.wizard.form</field>
            <field name="model">orbus.create.invoice.wizard</field>
            <field name="arch" type="xml">
                <form string="Creer une facture depuis Orbus" create="false" edit="false">
                    <group>
                        <field name="company_id"/>
                        <field name="numero_facture"/>
                    </group>
                    <footer>
                        <button string="Creer la facture" type="object"
                                name="action_create_invoice" class="btn-primary"/>
                        <button string="Annuler" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action du wizard -->
        <record id="action_orbus_create_invoice_wizard" model="ir.actions.act_window">
            <field name="name">Creer une facture Orbus</field>
            <field name="res_model">orbus.create.invoice.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Menu sous Orbus API -->
        <menuitem id="menu_orbus_create_invoice_wizard"
                  name="Creer une facture Orbus"
                  parent="menu_orbus_api_config_root"
                  action="action_orbus_create_invoice_wizard"
                  sequence="5"/>
    </data>
</odoo>
