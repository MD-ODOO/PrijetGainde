<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data> <!--  noupdate="1" -->
        <record id="sale_order_approval_form" model="ir.ui.view">
            <field name="name">sale.order.approval.form</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="model">sale.order</field>
            <field name="arch" type="xml">
                <button name="action_cancel" position="attributes">
                    <attribute name="invisible">state not in ['draft', 'sent', 'to approve', 'sale'] or not id</attribute>
                </button>
                <button name="action_cancel" position="before">
                    <button name="button_approve" type="object" string="Approve Order"
                            class="oe_highlight"
                            invisible="state not in ['to approve'] or not is_current_approver"/>
                </button>
                <field name="payment_term_id" position="after">
                    <field name="use_approval_route" invisible="True"/>
                    <field name="approval_route_id"
                           readonly="state != 'draft'"
                           invisible="use_approval_route == 'no'"
                           required="use_approval_route == 'required'"/>
                </field>
                <notebook position="inside">
                    <page name="approval_route" string="Approval Route"
                          invisible="state in ['draft', 'sent'] or approval_route_id == False">
                        <field name="approval_route_stage_ids">
                            <list>
                                <field name="sequence" invisible="True" widget="handle"/>
                                <field name="name"/>
                                <field name="user_ids" widget="many2many_avatar_user"/>
                                <field name="state"/>
                                <field name="decisions_summary"/>
                            </list>
                        </field>
                        <field name="is_current_approver" invisible="True"/>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>