    <!-- Bouton Mission -->
    <record id="view_audit_mission_form_report" model="ir.ui.view">
        <field name="name">audit.gainde.mission.form.report</field>
        <field name="model">audit_gainde.mission</field>
        <field name="inherit_id" ref="view_audit_gainde_mission_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="%(action_audit_mission_report)d"
