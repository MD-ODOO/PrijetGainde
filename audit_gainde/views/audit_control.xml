<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORMULAIRE Contrôle -->
    <record id="view_audit_gainde_control_form" model="ir.ui.view">
        <field name="name">audit.gainde.control.form</field>
        <field name="model">audit_gainde.control</field>
        <field name="arch" type="xml">
            <form string="Contrôle Audit Gainde">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="description" placeholder="Ex: Signature DG factures, Contrôle croisé achat/paiement"/>
                        </h1>
                    </div>
                    <group>
                            
                            <field name="risk_id"/>
                        </group>

                    <group>
                      
                        <group>
                            <field name="control_type" widget="radio"
                                   options="{'horizontal': true}"/>
                            <field name="frequency"/>
                        </group>
                        <group>
                            <field name="efficacy"/>
                        </group>
                    </group>                    
                </sheet>
            </form>
        </field>
    </record>

    <!-- LISTE Contrôles (LIST au lieu de tree) -->
    <record id="view_audit_gainde_control_list" model="ir.ui.view">
        <field name="name">audit.gainde.control.list</field>
        <field name="model">audit_gainde.control</field>
        <field name="arch" type="xml">
            <list decoration-success="efficacy=='high'"
                  decoration-warning="efficacy=='medium'"
                  decoration-danger="efficacy=='low'">
                <field name="description" optional="hide"/>
                <field name="control_type" widget="badge"/>
                <field name="frequency" widget="badge"/>
                <field name="efficacy" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ACTION MENU -->
    <record id="action_audit_gainde_control" model="ir.actions.act_window">
        <field name="name">Contrôles Audit</field>
        <field name="res_model">audit_gainde.control</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez vos contrôles internes pour protéger les risques !
            </p>
        </field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_audit_gainde_controls"
              name="Contrôles"
              parent="menu_audit_gainde_missions"
              action="action_audit_gainde_control"
              sequence="21"/>
</odoo>
