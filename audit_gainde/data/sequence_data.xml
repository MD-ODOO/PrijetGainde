<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Séquence Plans Audit -->
        <record id="seq_audit_plan" model="ir.sequence">
            <field name="name">Plan Audit</field>
            <field name="code">audit_gainde.plan</field>
            <field name="prefix">PLAN</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    <!-- MISSION avec ANNÉE AUTOMATIQUE -->
        <record id="seq_audit_gainde_mission" model="ir.sequence">
            <field name="name">Mission Audit Gainde</field>
            <field name="code">audit_gainde.mission</field>
            <field name="prefix">AUD-%(year)s-</field>
            <field name="padding">2</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

</odoo>
