<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="user_login_history_personal_rule" model="ir.rule">
        <field name="name">Personal Login History</field>
        <field ref="model_user_login_history" name="model_id"/>
        <field name="domain_force">[('user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="user_login_history_of_all" model="ir.rule">
        <field name="name">Login History Of All</field>
        <field ref="model_user_login_history" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="user_session_detail_personal_rule" model="ir.rule">
        <field name="name">Personal Login History</field>
        <field ref="model_user_session_detail" name="model_id"/>
        <field name="domain_force">[('user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="user_session_detail_of_all" model="ir.rule">
        <field name="name">Login History Of All</field>
        <field ref="model_user_session_detail" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
