<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_xf_loan" model="ir.module.category">
            <field name="name">Employee Loans</field>
            <field name="sequence">15</field>
        </record>
        <record id="group_xf_loan_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="category_id" ref="module_category_xf_loan"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_xf_loan_officer" model="res.groups">
            <field name="name">Officer</field>
            <field name="category_id" ref="module_category_xf_loan"/>
            <field name="implied_ids" eval="[(4, ref('xf_loan.group_xf_loan_employee'))]"/>
        </record>
        <record id="group_xf_loan_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_xf_loan"/>
            <field name="implied_ids" eval="[(4, ref('group_xf_loan_officer'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>