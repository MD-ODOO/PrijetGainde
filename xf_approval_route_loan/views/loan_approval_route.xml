<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_employee_loan_request_approval_form" model="ir.ui.view">
            <field name="name">hr.employee.loan.request.approval.form</field>
            <field name="inherit_id" ref="xf_loan.view_employee_loan_request_form"/>
            <field name="model">hr.employee.loan.request</field>
            <field name="arch" type="xml">

                <field name="first_payment_date" position="after">
                    <field name="use_approval_route" invisible="True"/>
                    <field name="approval_route_id"
                           readonly="state != 'draft'"
                           invisible="use_approval_route == 'no'"
                           required="use_approval_route == 'required'"/>
                </field>

                <notebook position="inside">
                    <page name="approval_route" string="Approval Route"
                          invisible="state in ['draft'] or not approval_route_id">
                        <field name="approval_route_stage_ids"/>
                        <field name="is_current_approver" invisible="True"/>
                    </page>
                </notebook>
            </field>
        </record>

    </data>
</odoo>