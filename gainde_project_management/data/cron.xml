<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_timesheet_reminder_weekly" model="ir.cron">
            <field name="name">Rappel saisie timesheets - Hebdomadaire</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._send_timesheet_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>


        <record id="ir_cron_weekly_project_performance" model="ir.cron">
            <field name="name">Project: Génération du Bilan SPI/CPI Hebdomadaire</field>
            <field name="model_id" ref="model_project_project"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_weekly_performance_reports()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall" eval="(datetime.now() + relativedelta(days=7)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
        <!-- CRON HEBDOMADAIRE -->
        <record id="ir_cron_project_weekly_report" model="ir.cron">
            <field name="name">Projet : Bilan Hebdomadaire Automatique</field>
            <field name="model_id" search="[('model', '=', 'project.project')]" model="ir.model"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_periodic_report(report_type='Hebdomadaire')</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>

        <!-- CRON MENSUEL -->
        <record id="ir_cron_project_monthly_report" model="ir.cron">
            <field name="name">Projet : Bilan Mensuel Automatique</field>
            <field name="model_id" search="[('model', '=', 'project.project')]" model="ir.model"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_periodic_report(report_type='Mensuel')</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
