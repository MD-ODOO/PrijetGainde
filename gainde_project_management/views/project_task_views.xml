<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_inherit_gainde" model="ir.ui.view">
        <field name="name">project.task.form.inherit.gainde</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allocated_hours']" position="attributes">
                <attribute name="help">Explication : Ce champ calcule le total des heures allouées via le planning.
                </attribute>
                <attribute name="string">Heures Allouées (Prévisions)</attribute>
            </xpath>

            <xpath expr="//field[@name='allocated_hours']" position="after">
                <p class="text-muted" invisible="allocated_hours > 0">
                    <i class="fa fa-info-circle"/>
                    Entrez ici le volume horaire prévu.
                </p>
            </xpath>
        </field>
    </record>

</odoo>
