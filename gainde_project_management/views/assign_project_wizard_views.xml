<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assign_project_wizard_form" model="ir.ui.view">
        <field name="name">assign.project.wizard.form</field>
        <field name="model">assign.project.wizard</field>
        <field name="arch" type="xml">
            <form string="Assigner un Projet aux Lignes d'Achat">
                <group>
                    <field name="project_id"/>
                    <field name="purchase_line_ids" widget="many2many_tags" invisible="True"/>
                </group>
                <footer>
                    <button name="action_assign_project" type="object" string="Assigner" class="btn-primary"/>
                    <button special="cancel" string="Annuler" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_assign_project_wizard" model="ir.actions.act_window">
        <field name="name">Assigner Projet</field>
        <field name="res_model">assign.project.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
