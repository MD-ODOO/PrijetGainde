<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_custom" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.custom</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_assign_project_wizard" type="object" string="Assigner Projet"
                        class="btn-primary"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="after">
                <field name="project_id" optional="show"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="after">
                <field name="project_id"/>
            </xpath>

        </field>
    </record>

    <record id="view_purchase_order_line_list_inherit_custom" model="ir.ui.view">
        <field name="name">purchase.order.line.list.inherit.custom</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="project_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
