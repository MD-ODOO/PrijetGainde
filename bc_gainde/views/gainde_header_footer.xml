<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="gainde_header_footer">
            <t t-name="web.external_layout_standard">
            <t t-foreach="docs" t-as="o">
                <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
                    <div class="row align-items-center">
                        <div class="col-6">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" 
                                style="max-height: 300px; max-width: 400px;margin-top:10px;" alt="Logo"/>
                        </div>

                        
                        <div  class="col-6 text-right">
                        <table style="border: 1px solid black; border-collapse: collapse; width: 100%; text-align: left; position: relative; top: 20px;">
                            <tr>
                                <td style="padding: 10px; padding-bottom: 30px; border: 1px solid black;">
                                    <strong><t t-esc="o.partner_id.name"/></strong><br/>
                                    <strong>E-mail:</strong> <t t-esc="o.partner_id.email"/><br/>
                                    <strong>Téléphone:</strong> <t t-esc="o.partner_id.mobile"/><br/>
                                    <strong>Adresses:</strong> <t t-esc="o.partner_id.street"/>
                                </td>
                            </tr>
                        </table>


                            <p style="font-size: 12px;margin-top: 20px;white-space: nowrap;"> N° de commande à rappeler obligatoirement sur toutes les factures</p>
                               
                        </div>



                    </div>
                    <!-- <div t-if="company.logo or company.report_header" class="row zero_min_height">
                        <div class="col-12">
                            <div style="border-bottom: 1px solid black;"/>
                        </div>
                    </div> -->
