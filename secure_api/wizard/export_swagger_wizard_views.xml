<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_export_swagger_wizard" model="ir.ui.view">
        <field name="name">view_export_swagger_wizard</field>
        <field name="model">export.swagger.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Swagger Wizard">
                <group string="Swagger / OpenAPI Specification">
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="version"/>
                    </group>
                    <group/>
                </group>
                <p>
                    <i>
                        Clicking 'Download' will download the Swagger/OpenAPI JSON specification file, which you can import into Swagger UI, Swagger Editor, or any OpenAPI-compatible tool.
                    </i>
                </p>         
                <p>
                    Do you want to export a Swagger/OpenAPI specification for the selected API(s)?
                </p>
                <footer>
                    <button string="Download" name="download_swagger_spec" type="object" default_focus="1" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_export_swagger_wizard" model="ir.actions.act_window">
        <field name="name">Export to Swagger</field>
        <field name="res_model">export.swagger.wizard</field>
        <field name="binding_model_id" ref="model_secure_api"/>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_export_swagger_wizard"/>
    </record>
</odoo>

