<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="secure_api_endpoint_tree_view" model="ir.ui.view">
            <field name="name">secure_api_endpoint_tree_view</field>
            <field name="model">secure.api.endpoint</field>
            <field name="arch" type="xml">
                <list string="Endpoints">
                    <field name="secure_api_id"/>
                    <field name="http_method_id"/>
                    <field name="route"/>
                    <field name="api_action"/>
                    <field name="is_bulk_operation"/>
                    <field name="data"/>
                    <field name="state" widget="badge" decoration-success="state == 'active'" decoration-danger="state == 'inactive'"/>
                </list>
            </field>
        </record>

        <record id="secure_api_endpoint_form_view" model="ir.ui.view">
            <field name="name">secure_api_endpoint_form_view</field>
            <field name="model">secure.api.endpoint</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="Endpoint Name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="http_method_id" options="{'no_create_edit': True, 'no_create': True}"/>
                                <field name="route"/>
                                <field name="secure_api_id" options="{'no_create_edit': True, 'no_create': True}"/>
                                <field name="state"/>
                            </group>
                            <group>
                                <field name="api_action"/>
                                <field name="is_bulk_operation"/>
                                <field name="data"/>
                            </group>
                        </group>
                        <group string="Generated cURL Command">
                            <field name="curl" widget="CopyClipboardChar" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_secure_api_endpoint" model="ir.actions.act_window">
            <field name="name">Endpoints</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">secure.api.endpoint</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('secure_api_endpoint_tree_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('secure_api_endpoint_form_view')})]"/>
        </record>
    </data>
</odoo>
