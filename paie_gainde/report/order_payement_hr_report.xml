<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
       

        <!-- ===============================
             ACTION REPORT
        ================================ -->
        <record id="action_report_ordre_virement_hr" model="ir.actions.report">
            <field name="name">Ordre de Virement</field>
            <field name="model">wizard.ordre.virement.hr</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">paie_gainde.report_pay_order</field>
            <field name="report_file">paie_gainde.report_pay_order</field>
            <field name="binding_model_id" ref="paie_gainde.model_wizard_ordre_virement_hr"/>
            <field name="binding_type">report</field>
        </record>

        <!-- ===============================
             QWEB TEMPLATE
        ================================ -->
    <template id="report_pay_order">
    <t t-call="web.html_container">
        <t t-call="web.external_layout">
            <div class="page">

                <h3 style="text-align:center;">ORDRE DE VIREMENT</h3>

                <p>
                    <strong>Période :</strong>
                    <t t-esc="date_start"/> au
                    <t t-esc="date_stop"/>
                </p>

                <table class="table table-bordered" style="width:100%;">
                    <thead>
                        <tr>
                            <th>Employé</th>
                            <th>Banque</th>
                            <th>Compte</th>
                            <th>Libellé</th>
                            <th style="text-align:right;">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="lines" t-as="l">
                            <tr>
                                <td><t t-esc="l['employee_name']"/></td>
                                <td><t t-esc="l['bank_name']"/></td>
                                <td><t t-esc="l['account_number']"/></td>
                                <td><t t-esc="l['libelle']"/></td>
                                <td style="text-align:right;">
                                    <t t-esc="'{0:,.0f}'.format(l['amount']).replace(',', ' ')"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="4" style="text-align:right;">TOTAL</th>
                            <th style="text-align:right;">
                                <t t-esc="'{0:,.0f}'.format(total_amount).replace(',', ' ')"/>
                            </th>
                        </tr>
                    </tfoot>
                </table>

            </div>
        </t>
    </t>
</template>



