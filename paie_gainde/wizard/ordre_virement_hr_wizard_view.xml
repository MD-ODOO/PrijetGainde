<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
         
<record id="view_hr_pay_order_line_list" model="ir.ui.view">
    <field name="name">hr.pay.order.line.list</field>
    <field name="model">hr.pay.order.line</field>
    <field name="arch" type="xml">
        <list >
            <field name="employee_id"/>
            <field name="bank_account_id"/>
            
            <field name="libelle"/>
            <field name="amount" sum="Total"/>
            
            <field name="order_id"/>
            <field name="bank_id"/>
            <field name="batch_id"/>
        </list>
    </field>
</record>

<record id="view_hr_pay_order_line_search" model="ir.ui.view">
    <field name="name">hr.pay.order.line.search</field>
    <field name="model">hr.pay.order.line</field>
    <field name="arch" type="xml">
        <search>

            <!-- ========================= -->
            <!-- CHAMPS DE RECHERCHE -->
            <!-- ========================= -->
            <field name="employee_id" string="Employé"/>
            <field name="bank_account_id" string="Banque"/>
            <field name="order_id" string="Lot"/>
            <field name="libelle" string="Libellé"/>
            <field name="bank_id"/>
            <field name="batch_id"/>

            <separator/>

            <!-- ========================= -->
            <!-- FILTRES RAPIDES -->
            <!-- ========================= -->
            <filter string="Compte Principal"
                    name="filter_principal"
                    domain="[('libelle','=','principal')]"/>

            <filter string="Virement Partiel"
                    name="filter_partiel"
                    domain="[('libelle','=','partiel')]"/>

            <filter string="Subvention"
                    name="filter_subvention"
                    domain="[('libelle','=','subvention')]"/>

            <separator/>

            <!-- ========================= -->
            <!-- REGROUPEMENTS -->
            <!-- ========================= -->
            <filter string="Grouper par Employé"
                    name="group_employee"
                    context="{'group_by':'employee_id'}"/>

            <filter string="Grouper par Banque"
                    name="group_bank"
                    context="{'group_by':'bank_id'}"/>

            <filter string="Grouper par Lot"
                    name="group_batch"
                    context="{'group_by':'order_id'}"/>

        </search>
    </field>
</record>


    <!-- LISTE -->
    
    <record id="hr_pay_order_list" model="ir.ui.view">
        <field name="name">hr.pay.order.list</field>
        <field name="model">hr.pay.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="bank_id"/>
                <field name="date_start"/>
                <field name="date_stop"/>
                <field name="total_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- FORMULAIRE -->
    <record id="hr_pay_order_form" model="ir.ui.view">
        <field name="name">hr.pay.order.form</field>
        <field name="model">hr.pay.order</field>
        <field name="arch" type="xml">
            <form>

                <!-- HEADER -->
                <header>

                    <button name="action_compute"
                            type="object"
                            string="Calculer"
                            class="btn-primary"
                            modifiers="{'invisible': [['state','!=','draft']]}"/>

                    <button name="action_confirm"
                            type="object"
                            string="Confirmer"
                            class="btn-success"
                            modifiers="{'invisible': [['state','!=','draft']]}"/>

                    <!-- statusbar TOUJOURS VALIDE -->
                    <field name="state" widget="statusbar"/>

                </header>

                <sheet>
                    <group>
    <field name="name" readonly="1"/>
    <field name="bank_id"/>
</group>
                    <group>
                        <field name="date_start"/>
                        <field name="date_stop"/>
                    </group>
                    

                    <group>
                        <field name="total_amount" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Lignes de virement">
                            <field name="line_ids" nolabel="1">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="bank_account_id"/>
                                    <field name="libelle"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>

                        <page string="Bulletins">
                            <field name="payslip_ids" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>

            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_hr_pay_order" model="ir.actions.act_window">
        <field name="name">Ordres de virement</field>
        <field name="res_model">hr.pay.order</field>
        <field name="view_mode">list,form</field>
    </record>
    
    
    <!-- lot de virement #############################################"" -->
    <record id="view_hr_pay_batch_list" model="ir.ui.view">
    <field name="name">hr.pay.batch.list</field>
    <field name="model">hr.pay.batch</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="date_start"/>
            <field name="date_stop"/>
            <field name="state"/>
            <field name="order_ids" widget="many2many_tags"/>
        </list>
    </field>
</record>
    
    <record id="view_hr_pay_batch_form" model="ir.ui.view">
        <field name="name">hr.pay.batch.form</field>
        <field name="model">hr.pay.batch</field>
        <field name="arch" type="xml">

            <form string="Lot de virement">

                <!-- HEADER -->
                <header>
                    <button name="action_generate"
                            type="object"
                            string="Générer les ordres"
                            class="btn-primary"
                            modifiers="{'invisible': [['state','!=','draft']]}"/>

                    <field name="state" widget="statusbar"/>
                    <button name="action_export_bank_excels"
        type="object"
        string="Exporter fichiers bancaires"
        class="btn-success"
        modifiers="{'invisible': [['state','!=','orders_generated']]}"/>
        <button name="action_reset_to_draft"
        type="object"
        string="Annuler la génération"
        class="btn-secondary"
        modifiers="{'invisible': [['state','!=','generated']]}"/>
        <button name="action_view_employee_transfers"
        type="object"
        string="Virements des employés"
        class="btn-info"
        modifiers="{'invisible': [['state','!=','generated']]}"/>
                </header>

                <sheet>

                    <!-- INFORMATIONS GÉNÉRALES -->
                    <group string="Informations générales">
                        <field name="name" readonly="1"/>
                        <field name="date_start"/>
                        <field name="date_stop"/>
                    </group>

                    <notebook>

                        <!-- BANQUES -->
                        <page string="Banques">
                            <field name="bank_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="bank_id"/>
                                </list>
                            </field>
                        </page>

                        <!-- ORDRES GÉNÉRÉS -->
                        <page string="Ordres de virement générés">
                            <field name="order_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="bank_id"/>
                                    <field name="total_amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>

<record id="action_hr_pay_batch" model="ir.actions.act_window">
    <field name="name">Lots de virement</field>
    <field name="res_model">hr.pay.batch</field>
    <field name="view_mode">list,form</field>
</record>

    


        <!-- Vue Formulaire du Wizard -->
        


    <record id="ordre_virement_hr_wizard_form" model="ir.ui.view">
        <field name="name">wizard.ordre.virement.hr.form</field>
        <field name="model">wizard.ordre.virement.hr</field>
        <field name="arch" type="xml">
            <form string="Ordre de virement">

                <group string="Période">
                    <field name="date_start"/>
                    <field name="date_stop"/>
                </group>

                <group>
                    <field name="bank_id"/>
                </group>

                <group string="Bulletins de paie">
                    <field name="payslip_ids"
                          />
                </group>

                <group string="Détails des virements">
                    <field name="line_ids" nolabel="1">
                        <list>
                            <field name="employee_id"/>
                            <field name="bank_account_id"/>
                            <field name="libelle"/>
                            <field name="amount" widget="monetary"/>
                        </list>
                    </field>
                </group>

                <group>
                    <field name="total_amount"
                           readonly="1"
                           widget="monetary"/>
                </group>

                <footer>
                    <button type="object"
                            name="action_print_report"
                            string="Imprimer"
                            class="btn-primary"/>
                    <button string="Annuler"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>

            </form>
        </field>
    </record>




        <!-- Action pour ouvrir le Wizard -->
        <record id="action_ordre_virement_hr_wizard" model="ir.actions.act_window">
            <field name="name">Ordre de virement employés</field>
            <field name="res_model">wizard.ordre.virement.hr</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="ordre_virement_hr_wizard_form"/>
            <field name="target">new</field>
        </record>

        <!-- Menu pour accéder au Wizard -->
         <menuitem
            id="menu_ordre_virement_hr_root"
            name="Ordres de virement"
            parent="hr_payroll.menu_hr_payroll_payslips"
            sequence="300"/>
            
       <!-- <menuitem
            id="menu_ordre_virement_hr"
            name="Ordre de virement payement employés"
            parent="menu_ordre_virement_hr_root"
            action="action_ordre_virement_hr_wizard"
            sequence="6"/>
        
        - MENU -->
    

          <menuitem id="menu_hr_pay_order"
              name="Ordres de virement"
              parent="menu_ordre_virement_hr_root"
              action="action_hr_pay_order"
              sequence="200"
              groups="hr_contract.group_hr_contract_employee_manager"/>
              
          <menuitem id="menu_hr_pay_lot"
              name="Lot Ordres de virement"
              parent="menu_ordre_virement_hr_root"
              action="action_hr_pay_batch"
              sequence="300"
              groups="hr_contract.group_hr_contract_employee_manager"/>
              

    </data>
</odoo>
