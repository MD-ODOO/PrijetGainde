```
    <!-- IPRES Salarial -->
    <record id="RULE_IPRES_SAL" model="hr.salary.rule">
        <field name="name">IPRES Salarial</field>
        <field name="code">C3000</field>
        <field name="sequence">400</field>
        <field name="category_id" ref="SALC"/>
