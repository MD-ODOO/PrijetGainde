    </record>

    <record id="DEDIRPP_2" model="hr.salary.rule.category">
        <field name="name">Déduction IR Palier 2</field>
        <field name="code">DEDIRPP_2</field>
        <field name="parent_id" ref="RETENUES"/>
    </record>

    <record id="NET" model="hr.salary.rule.category">
        <field name="name">Salaire Net</field>
        <field name="code">NET</field>
        <field name="parent_id" eval="False"/>
    </record>

    <!-- ===================================================== -->
    <!-- 2. REGISTRES DE COTISATIONS                           -->
    <!-- ===================================================== -->

    <record id="REG_CNSS" model="hr.contribution.register">
        <field name="name">Caisse Nationale de Sécurité Sociale</field>
    </record>

    <record id="REG_IPRES" model="hr.contribution.register">
        <field name="name">IPRES</field>
    </record>

