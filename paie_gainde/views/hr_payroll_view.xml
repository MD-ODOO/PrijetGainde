          <record id="view_prime_attribution_tree" model="ir.ui.view">
    <field name="name">prime.attribution.tree</field>
    <field name="model">prime.attribution</field>
    <field name="arch" type="xml">
        <list  decoration-success="state == 'active'"
                  decoration-danger="state == 'expired'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="categ_id"/>
                <field name="type_prime"/>
                <field name="valeur_prime"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="state"/>
        </list>
    </field>
</record>
          
          <record id="view_prime_attribution_form" model="ir.ui.view">
    <field name="name">prime.attribution.form</field>
    <field name="model">prime.attribution</field>
    <field name="arch" type="xml">
        <form string="Attribution Prime">
            <header>
            <button name="action_confirm"
                            string="Confirmer"
                            type="object"
                            class="btn-primary"
                            invisible="manual_state != 'draft'"/>

                    <!-- Annuler visible sauf si déjà annulé -->
                    <button name="action_cancel"
                            string="Annuler"
                            type="object"
                            class="btn-danger"
                            invisible="manual_state == 'cancelled'"/>

                    <!-- Reset visible seulement si annulé -->
                    <button name="action_reset_draft"
                            string="Remettre en brouillon"
                            type="object"
                            invisible="manual_state != 'cancelled'"/>

                    <!-- Statusbar dynamique -->
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,active,expired,cancelled"/>
            
            </header>
            <sheet>
                 <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="categ_id"/>
                            <field name="type_prime"/>
                        </group>
                        <group>
                            <field name="valeur_prime"/>
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                        </group>
                    </group>
                    <notebook>
    <page string="Employés concernés">
        <field name="employee_line_ids">

            <list >

                <field name="employee_id"/>
                <field name="contract_id"/>

                <!-- Visible si religieuse -->
                <field name="prime_religieuse"
                       invisible="parent.type_prime != 'religieuse'"/>

                <!-- Visible si technique -->
                <field name="prime_tech"
                       invisible="parent.type_prime != 'tech'"/>

                <!-- Visible si 13eme -->
                <field name="trezieme_moi"
                       invisible="parent.type_prime != '13eme'"/>

            </list>

        </field>
    </page>
</notebook>
            </sheet>
        </form>
    </field>
</record>
        
        
          <record id="action_attribution_prime" model="ir.actions.act_window">
    <field name="name">Attribution Prime</field>
    <field name="res_model">prime.attribution</field>
    <field name="view_mode">list,form</field>
     </record>
        
      

    
  
  
     
          
          
          <record id="seq_prime_attribution" model="ir.sequence">
          <field name="name">Prime Attribution</field>
          <field name="code">prime.attribution</field>
          <field name="prefix">PRIME/</field>
          <field name="padding">4</field>
      </record>
    


    

  </data>
</odoo>
