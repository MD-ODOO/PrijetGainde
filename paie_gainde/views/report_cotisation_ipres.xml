        text-align: right;
        white-space: nowrap;
    }
</style>


<div class="page">

    <!-- HEADER ENTREPRISE -->
    <table class="no-border">
        <tr>
            <td>
                <img t-if="company.logo"
                     t-att-src="'data:image/png;base64,' + company.logo.decode('utf-8')"
                     style="height:55px;"/><br/>
                <strong><t t-esc="company.name"/></strong><br/>
                <t t-esc="company.street or ''"/><br/>
                <t t-esc="company.city or ''"/><br/>
                <t t-esc="company.phone or ''"/>
            </td>
        </tr>
    </table>

    <h2>LIVRE DE PAIE ET CUMUL PAR MATRICULE ET PAR RUBRIQUE</h2>
    <div class="year">Annee <t t-esc="year"/></div>
    <div class="period">
        Période du : <t t-esc="date_from"/> au <t t-esc="date_to"/>
    </div>

    <t t-foreach="employees.items()" t-as="emp_data">
        <t t-set="employee" t-value="emp_data[0]"/>
        <t t-set="lines" t-value="emp_data[1]"/>

        <div class="matricule">
            Matricule : <t t-esc="employee.registration_number or ''"/> 
            <t t-esc="employee.name"/>
        </div>
        <div class="period">
            Employé : 
            <t t-esc="employee.name"/>
        </div>

        <table>
            <thead>
                <tr>
                    <th style="width:15%;">Code</th>
                    <th style="width:65%;">Rubrique</th>
                    <th style="width:20%; text-align:right;">Cumul annuel</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="lines.items()" t-as="item">
                    <tr>
                        <td><t t-esc="item[0][0]"/></td>
                        <td><t t-esc="item[0][1]"/></td>
                        <td class="amount">
                            <t t-esc="('%.2f' % item[1])"/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>

        <div style="page-break-after:always;"></div>
    </t>

</div>

</t>
</t>
