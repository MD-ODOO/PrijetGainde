<template id="report_vrs_template">
<t t-call="web.html_container">
<t t-call="web.external_layout">

<style>
body {
  font-size: 12px;
  color: #000;
}

/* ===== TITRE ===== */
.vrs-title {
  text-align: center;
  font-size: 28px;
  font-weight: bold;
  color: #1f4fd8;
  text-decoration: underline;
  margin: 12px 0 16px 0;
}

/* ===== BLOCS INFO ===== */
.vrs-block {
  font-size: 12px;
  margin-bottom: 4px;
  text-align: right;
}

/* ===== TABLE ===== */
table.vrs-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}

table.vrs-table th,
table.vrs-table td {
  border: 1px solid #000;
  padding: 6px;
}

table.vrs-table th {
  font-weight: bold;
  background: #f2f2f2;
}

.text-right {
  text-align: right;
}

.text-center {
  text-align: center;
}
</style>

<!-- ===== TITRE OFFICIEL ===== -->
<div class="vrs-title">
  Etat de déclaration mensuelle des impôts VRS
</div>

<!-- ===== ENTREPRISE ===== -->
<div class="vrs-block">
  <strong>Entreprise :</strong>
  <t t-esc="env.company.name"/>
</div>

<div class="vrs-block">
  <strong>Pays :</strong>
  <t t-esc="env.company.country_id and env.company.country_id.name or ''"/>
</div>

<!-- ===== PERIODE ===== -->
<div class="vrs-block">
  <strong>Période :</strong>
  <t t-esc="env.context.get('date_from') or ''"/>
  au
  <t t-esc="env.context.get('date_to') or ''"/>
</div>

<!-- ===== DATE IMPRESSION ===== -->
<div class="vrs-block">
  <strong>Date impression :</strong>
  <t t-esc="env.context.get('print_date') or ''"/>
</div>

<br/>

<!-- ===== DONNEES ===== -->
<t t-set="payslips"
   t-value="env['hr.payslip'].search([
      ('state', '=', 'paid'),
      ('date_from', '&lt;=', env.context.get('date_to')),
      ('date_to', '&gt;=', env.context.get('date_from')),
      ('company_id', '=', env.company.id),
   ])"/>

   


<!-- ===== CUMULS ===== -->
<t t-set="t_gross" t-value="0"/>
<t t-set="t_ir" t-value="0"/>
<t t-set="t_trimf" t-value="0"/>
<t t-set="t_cfce" t-value="0"/>
<t t-set="t_total" t-value="0"/>

<table class="vrs-table">
  <thead>
    <tr>
      <th class="text-center">Matricule</th>
      <th>Nom et Prenom</th>
      <th class="text-right">Brut imposable</th>
      <th class="text-right">IR</th>
      <th class="text-right">TRIMF</th>
      <th class="text-right">CFCE</th>
      <th class="text-right">Total</th>
    </tr>
  </thead>

  <tbody>
    <t t-foreach="payslips" t-as="slip">

      <t t-set="gross"
         t-value="sum(slip.line_ids.filtered(lambda l: l.code=='GROSS').mapped('amount'))"/>

      <t t-set="ir"
         t-value="sum(slip.line_ids.filtered(lambda l: l.code=='CSAL1').mapped('amount'))"/>

      <t t-set="trimf"
         t-value="sum(slip.line_ids.filtered(lambda l: l.code=='CSAL2').mapped('amount'))"/>

      <t t-set="cfce"
         t-value="sum(slip.line_ids.filtered(lambda l: l.code=='CPAT5').mapped('amount'))"/>

      <t t-set="line_total" t-value="ir + trimf + cfce"/>

      <tr>
        <td class="text-center">
          <t t-esc="slip.employee_id.identification_id"/>
        </td>
        <td>
          <t t-esc="slip.employee_id.name"/>
        </td>
        <td class="text-right">
          <t t-esc="gross"/>
        </td>
        <td class="text-right">
          <t t-esc="ir"/>
        </td>
        <td class="text-right">
          <t t-esc="trimf"/>
        </td>
        <td class="text-right">
          <t t-esc="cfce"/>
        </td>
        <td class="text-right">
          <t t-esc="line_total"/>
        </td>
      </tr>

      <!-- CUMUL -->
      <t t-set="t_gross" t-value="t_gross + gross"/>
      <t t-set="t_ir" t-value="t_ir + ir"/>
      <t t-set="t_trimf" t-value="t_trimf + trimf"/>
      <t t-set="t_cfce" t-value="t_cfce + cfce"/>
      <t t-set="t_total" t-value="t_total + line_total"/>

    </t>

    <!-- ===== TOTAL GENERAL (DERNIERE PAGE) ===== -->
    <tr>
      <th colspan="2">TOTAL</th>
      <th class="text-right"><t t-esc="t_gross"/></th>
      <th class="text-right"><t t-esc="t_ir"/></th>
      <th class="text-right"><t t-esc="t_trimf"/></th>
      <th class="text-right"><t t-esc="t_cfce"/></th>
      <th class="text-right"><t t-esc="t_total"/></th>
    </tr>

  </tbody>
</table>

</t>
</t>
</template>







