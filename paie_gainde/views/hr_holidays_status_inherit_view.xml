<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_hr_leave_type_form_inherit_code" model="ir.ui.view">
            <field name="name">hr.leave.type.form.inherit.code</field>
            <field name="model">hr.leave.type</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_type_view_form"/>
            <field name="arch" type="xml">

                <!-- Ajout du champ Code après le premier champ -->
                <xpath expr="//form/sheet/group/field[1]" position="after">
                    <field name="code"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
