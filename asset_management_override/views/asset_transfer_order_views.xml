<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Modifier l'ordre d'affichage des transferts (le plus récent en premier) -->
        <record id="asset_management_form_transfer_order" model="ir.ui.view">
            <field name="name">asset.management.form.transfer.order</field>
            <field name="model">asset.management</field>
            <field name="inherit_id" ref="asset_management.view_asset_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='transfer_ids']/list" position="attributes">
                    <attribute name="default_order">id desc</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

