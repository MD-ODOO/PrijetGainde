<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="stock_picking_form_assets_smart_button" model="ir.ui.view">
            <field name="name">stock.picking.form.assets.smart.button</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <!-- Ajouter le bouton après le bouton "Returns" -->
                <button name="action_see_returns" position="after">
                    <button name="action_view_assets"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-cubes"
                            invisible="asset_count == 0">
                        <field name="asset_count" widget="statinfo" string="Actifs"/>
                    </button>
                </button>
            </field>
        </record>
    </data>
</odoo>

