<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="hr_employee_form_assets_smart_button" model="ir.ui.view">
            <field name="name">hr.employee.form.assets.smart.button</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_assets"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-cubes">
                        <field name="asset_count" widget="statinfo" string="Assets"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
