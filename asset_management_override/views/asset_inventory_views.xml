<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ── Vue liste Inventaire ──────────────────────────── -->
        <record id="view_asset_inventory_list" model="ir.ui.view">
            <field name="name">asset.management.inventory.list</field>
            <field name="model">asset.management</field>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <list string="Inventaire"
                      decoration-muted="status == 'destroyed'"
                      multi_edit="1"
                      create="0">
                    <field name="barcode"       string="Barcode"/>
                    <field name="name"          string="Nom de l'Actif"/>
                    <field name="tag_ids"       string="Étiquettes"
                                                widget="many2many_tags"
                                                options="{'color_field': 'color'}"
                                                optional="show"/>
                    <field name="current_stock" string="Stock Actuel"
                                                sum="Stock total"/>
                    <field name="assigne_a"     string="Utilisateur Assigné"
                                                optional="show"/>
                    <field name="transfer_count" string="Historique"
                                                 optional="show"/>
                    <field name="status"        string="Statut"
                                                widget="badge"
                                                decoration-success="status == 'assign'"
                                                decoration-info="status == 'in_warehouse'"
                                                decoration-warning="status in ('repair', 'on_hold', 'return')"
                                                decoration-danger="status == 'destroyed'"/>
                    <field name="amount"        string="Valorisation"
                                                sum="Valorisation totale"/>
                </list>
            </field>
        </record>

        <!-- ── Filtre favori partagé "Inventaire" ────────────── -->
        <record id="filter_asset_inventaire" model="ir.filters">
            <field name="name">Inventaire</field>
            <field name="model_id">asset.management</field>
            <field name="domain">[('status', '!=', 'destroyed')]</field>
            <field name="context">{"group_by": ["asset_type_id"]}</field>
            <field name="is_default" eval="False"/>
        </record>

        <!-- ── Action Inventaire ─────────────────────────────── -->
        <record id="action_asset_inventory" model="ir.actions.act_window">
            <field name="name">Inventaire</field>
            <field name="res_model">asset.management</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_asset_inventory_list"/>
            <field name="domain">[('status', '!=', 'destroyed')]</field>
            <field name="context">{"group_by": ["asset_type_id"]}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Aucun actif trouvé
                </p>
                <p>
                    L'inventaire affiche tous les actifs actifs regroupés par type.
                </p>
            </field>
        </record>

        <!-- ── Menu Inventaire sous Rapports ─────────────────── -->
        <menuitem id="menu_asset_inventory"
                  name="Inventaire"
                  parent="asset_management.menu_asset_reporting"
                  action="action_asset_inventory"
                  groups="asset_management.assets_user_group,asset_management.assets_admin_group,base.group_system"
                  sequence="1"/>

    </data>
</odoo>
