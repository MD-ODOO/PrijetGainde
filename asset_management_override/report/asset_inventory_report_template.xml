<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_asset_inventory_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="inv">
                    <t t-set="company" t-value="env.company"/>
                    <t t-call="web.external_layout">
                        <div class="page">

                            <!-- ── En-tête ──────────────────────────────────── -->
                            <div class="row mb-4">
                                <div class="col-8">
                                    <h2 class="mb-1">Rapport d'inventaire</h2>
                                    <table class="table table-sm table-borderless" style="width:auto;">
                                        <tr>
                                            <td class="text-muted pe-3">Référence</td>
                                            <td><strong><t t-out="inv.name"/></strong></td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted pe-3">Période</td>
                                            <td>
                                                <t t-out="inv.date_start"/>
                                                <t t-if="inv.date_end"> → <t t-out="inv.date_end"/></t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted pe-3">Opérateur</td>
                                            <td><t t-out="inv.operator_id.name"/></td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted pe-3">État</td>
                                            <td>
                                                <t t-if="inv.state == 'draft'">Brouillon</t>
                                                <t t-elif="inv.state == 'in_progress'">En cours</t>
                                                <t t-else="">Terminé</t>
                                            </td>
                                        </tr>
                                        <t t-if="inv.notes">
                                            <tr>
                                                <td class="text-muted pe-3">Notes</td>
                                                <td><t t-out="inv.notes"/></td>
                                            </tr>
                                        </t>
                                    </table>
                                </div>
                                <div class="col-4 text-end">
                                    <div class="border rounded p-3 d-inline-block">
                                        <div class="text-muted small mb-1">Résumé</div>
                                        <div>
                                            <span class="badge bg-success me-1">
                                                <t t-out="inv.scanned_count"/> scannés
                                            </span>
                                        </div>
                                        <div class="mt-1">
                                            <span class="badge bg-danger me-1">
                                                <t t-out="inv.missing_count"/> manquants
                                            </span>
                                        </div>
                                        <t t-if="inv.unexpected_count">
                                            <div class="mt-1">
                                                <span class="badge bg-warning">
                                                    <t t-out="inv.unexpected_count"/> inattendus
                                                </span>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>

                            <!-- ── Actifs trouvés ────────────────────────────── -->
                            <t t-set="found_lines" t-value="inv.line_ids.filtered(lambda l: l.state == 'found')"/>
                            <h4 class="mt-3 mb-2" style="color:#2e7d32;">
                                Actifs trouvés (<t t-out="len(found_lines)"/>)
                            </h4>
                            <t t-if="found_lines">
                                <table class="table table-sm table-bordered table-striped">
                                    <thead class="table-success">
                                        <tr>
                                            <th>Nom de l'actif</th>
                                            <th>Code-barres</th>
                                            <th>Localisation</th>
                                            <th>Assigné à</th>
                                            <th>Date acquisition</th>
                                            <th>Scanné le</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="found_lines" t-as="line">
                                            <tr>
                                                <td><t t-out="line.asset_id.name or ''"/></td>
                                                <td><t t-out="line.barcode or ''"/></td>
                                                <td><t t-out="line.localisation_id.name if line.localisation_id else ''"/></td>
                                                <td><t t-out="line.assigne_a.name if line.assigne_a else ''"/></td>
                                                <td>
                                                    <t t-if="line.invoice_date">
                                                        <t t-out="line.invoice_date.strftime('%d/%m/%Y')"/>
                                                    </t>
                                                </td>
                                                <td>
                                                    <t t-if="line.scan_date">
                                                        <t t-out="line.scan_date.strftime('%d/%m/%Y %H:%M')"/>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                            <t t-else="">
                                <p class="text-muted fst-italic">Aucun actif scanné.</p>
                            </t>

                            <!-- ── Actifs manquants ──────────────────────────── -->
                            <t t-set="missing_assets" t-value="inv._get_missing_assets()"/>
                            <div style="page-break-before: auto;">
                                <h4 class="mt-4 mb-2" style="color:#c62828;">
                                    Actifs non trouvés (<t t-out="len(missing_assets)"/>)
                                </h4>
                                <t t-if="missing_assets">
                                    <table class="table table-sm table-bordered table-striped">
                                        <thead class="table-danger">
                                            <tr>
                                                <th>Nom de l'actif</th>
                                                <th>Code-barres</th>
                                                <th>Localisation</th>
                                                <th>Assigné à</th>
                                                <th>Date acquisition</th>
                                                <th>Statut</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="missing_assets" t-as="asset">
                                                <tr>
                                                    <td><t t-out="asset.name or ''"/></td>
                                                    <td><t t-out="asset.barcode or ''"/></td>
                                                    <td><t t-out="asset.localisation.name if asset.localisation else ''"/></td>
                                                    <td><t t-out="asset.assigne_a.name if asset.assigne_a else ''"/></td>
                                                    <td>
                                                        <t t-if="asset.invoice_date">
                                                            <t t-out="asset.invoice_date.strftime('%d/%m/%Y')"/>
                                                        </t>
                                                    </td>
                                                    <td><t t-out="dict(asset.fields_get(['status'])['status']['selection']).get(asset.status, asset.status)"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <p class="text-muted fst-italic" style="color:#2e7d32;">
                                        Tous les actifs ont été trouvés.
                                    </p>
                                </t>
                            </div>

                            <!-- ── Codes inconnus (inattendus) ────────────────── -->
                            <t t-set="unexpected_lines" t-value="inv.line_ids.filtered(lambda l: l.state == 'unexpected')"/>
                            <t t-if="unexpected_lines">
                                <h4 class="mt-4 mb-2" style="color:#e65100;">
                                    Codes inconnus (<t t-out="len(unexpected_lines)"/>)
                                </h4>
                                <table class="table table-sm table-bordered">
                                    <thead class="table-warning">
                                        <tr>
                                            <th>Code scanné</th>
                                            <th>Scanné le</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="unexpected_lines" t-as="line">
                                            <tr>
                                                <td><t t-out="line.barcode or ''"/></td>
                                                <td>
                                                    <t t-if="line.scan_date">
                                                        <t t-out="line.scan_date.strftime('%d/%m/%Y %H:%M')"/>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>

                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
