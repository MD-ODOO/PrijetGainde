<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================= -->
        <!-- Groupe Employé -->
        <!-- ========================= -->
        <record id="group_employee_self_service" model="res.groups">
            <field name="name">Ma fiche</field>
            <field name="category_id"
                   ref="base.module_category_human_resources"/>
        </record>

        <!-- ========================= -->
        <!-- Employé : sa fiche -->
        <!-- ========================= -->
        <record id="rule_employee_own_profile" model="ir.rule">
            <field name="name">Employee: access to own profile only</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">
                [('user_id', '=', user.id)]
            </field>
            <field name="groups"
                   eval="[(4, ref('employee_self_service_enterprise.group_employee_self_service'))]"/>
        </record>

        <!-- ========================= -->
        <!-- RH / ADMIN : tout voir -->
        <!-- ========================= -->
        <record id="rule_hr_employee_full_access" model="ir.rule">
            <field name="name">HR/Admin: access all employees</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[
                       (4, ref('hr.group_hr_manager')),
                       (4, ref('hr.group_hr_user')),
                       (4, ref('base.group_system'))
                   ]"/>
        </record>

    </data>
</odoo>
