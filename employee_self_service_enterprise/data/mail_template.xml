<?xml version="1.0" encoding="utf-8"?>
<odoo>
    

        <record id="email_template_payslip_employee" model="mail.template">
            <field name="name">Bulletins de paie mensuels</field>
            <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
            <field name="subject">Vos bulletins de paie</field>

            <!-- SAFE en Enterprise -->
            <field name="email_from">${(user.email or '')}</field>
            <field name="email_to">${object.employee_id.work_email}</field>

            <field name="body_html" type="html">
                <![CDATA[
                    <p>Bonjour ${object.employee_id.name},</p>

                    <p>
                        Veuillez trouver en pièces jointes vos bulletins de paie
                        pour la période concernée.
                    </p>

                    <p>
                        Cordialement,<br/>
                        Service RH
                    </p>
                ]]>
            </field>
        </record>

    
</odoo>
