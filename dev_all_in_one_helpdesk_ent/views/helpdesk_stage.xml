<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="helpdesk_stage_solution_view" model="ir.ui.view">
	<field name="name">helpdesk.stage.solution.view</field>
	<field name="model">helpdesk.stage</field>
	<field name="inherit_id" ref="helpdesk.helpdesk_stage_view_form"/>
	<field name="arch" type="xml">
    	<xpath expr="//field[@name='fold']" position="after">
	            <field name="is_solve" />
    	</xpath>
	</field>
</record>
</odoo> 
	 
