<odoo>
        <record id="view_whatsapp_message_template_form" model="ir.ui.view">
            <field name="name">view.whatsapp.message.template.form</field>
            <field name="model">whatsapp.message.template</field>
            <field name="arch" type="xml">
                <form string="Message Template">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                    <group string="Whatsapp Message"/>
                        <field name="whatsapp_message" widget='html'/>
                </sheet>
                </form>
            </field>
        </record>
        
        <record id="whatsapp_message_template_tree" model="ir.ui.view">
            <field name="name">whatsapp.message.template.tree</field>
            <field name="model">whatsapp.message.template</field>
            <field name="arch" type="xml">
                <list string="Message Template">
                    <field name="name" string="Name"/>
                </list>
            </field>
        </record>
        
        <record id="action_whatsapp_message_template" model="ir.actions.act_window">
            <field name="name">Message Template</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">whatsapp.message.template</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
        </record>
        
	<!--  Menu Items-->
    <menuitem name="Whatsapp Message Template"
              id="menu_wha_message_template"
              parent="helpdesk.helpdesk_menu_config"
              action="action_whatsapp_message_template"
              sequence="11"
              />
</odoo>
