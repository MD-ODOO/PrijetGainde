<odoo>
    
    <record id="view_dev_knowledge_form" model="ir.ui.view">
        <field name="name">view.dev.knowledge.form</field>
        <field name="model">dev.knowledge</field>
        <field name="arch" type="xml">
            <form string="Knowledge">
                <sheet>
                    <div name="button_box" class="oe_button_box">
                    </div>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible='active == True'/>
<!--                    attrs="{'invisible': [('active', '=', True)]}"-->
                    <group>
                        <group>
                            <field name="name" required='1'/>
                        </group>
                        <group>
                            <field name="category_id" required='1'/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Solution">
                            <field name="solution"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!--tree View-->
    <record id="view_dev_knowledge_tree" model="ir.ui.view">
        <field name="name">view.knowledge.tree`</field>
        <field name="model">dev.knowledge</field>
        <field name="arch" type="xml">
            <list string="Knowledge">
                <field name="name"/>
                <field name="category_id"/>
                <field name="tag_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    
    <record id="view_dev_knowledge_filter" model="ir.ui.view">
        <field name="name">view.dev.knowledge.filter</field>
        <field name="model">dev.knowledge</field>
        <field name="arch" type="xml">
            <search string="Tags">
                <field name="name" filter_domain="[('name','ilike',self)]" string="Name"/>
            	<field name="category_id" string="Category"/>
            	<field name="tag_ids" string='Tags'/>
                <separator/>
                <filter string="Archived" name="knowledge_archive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By" colspan="16">
                    <filter name="category_id" string="Category" context="{'group_by':'category_id'}"/>
                </group>
            </search>
        </field>
    </record>
    

    <!--Action View-->
    <record id="action_dev_knowledge" model="ir.actions.act_window">
        <field name="name">Knowledge</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dev.knowledge</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--Menus-->
    <menuitem name="Knowledge" id="menu_knowledge_main" parent='menu_knowledge_root' action="action_dev_knowledge" sequence='1'/>   
</odoo>
