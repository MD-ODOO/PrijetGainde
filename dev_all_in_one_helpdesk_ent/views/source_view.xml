<odoo>
	<!--tree View-->
    <record id="tree_source_view" model="ir.ui.view">
        <field name="name">tree.source.view</field>
        <field name="model">dev.helpdesk.source</field>
        <field name="arch" type="xml">
            <list string="Source" editable='bottom'>
                <field name="name" required='1'/> 
            </list>
        </field>
    </record>

    <!--Action View-->
    <record id="action_source_view" model="ir.actions.act_window">
        <field name="name">Source</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dev.helpdesk.source</field>
        <field name="view_mode">list</field>
    </record>

    <!--Menus-->
    <menuitem name="Source" id="menu_source" parent='helpdesk.helpdesk_menu_config' action="action_source_view" sequence='2'/>   
</odoo>
