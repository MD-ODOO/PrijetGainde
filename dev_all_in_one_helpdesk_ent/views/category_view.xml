<odoo>

    <!--tree View-->
    <record id="tree_knowledge_category_view" model="ir.ui.view">
        <field name="name">view.knowledge.category.tree`</field>
        <field name="model">dev.knowledge.category</field>
        <field name="arch" type="xml">
            <list string="Category" editable='bottom'>
                <field name="name" required='1'/>
            </list>
        </field>
    </record>

    <!--Action View-->
    <record id="action_knowledge_category" model="ir.actions.act_window">
        <field name="name">Category</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dev.knowledge.category</field>
        <field name="view_mode">list</field>
    </record>

    <!--Menus-->
    <menuitem name="Category" id="menu_knowledge_category" parent='menu_dev_knowledge_configration' action="action_knowledge_category" sequence='2'/>   
</odoo>
