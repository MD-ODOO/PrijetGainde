<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Héritage de la vue formulaire helpdesk.ticket pour ajouter le bouton d'annulation -->
    <record id="helpdesk_ticket_view_form_inherit_cancel" model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.form.inherit.cancel</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            
            <!-- Ajout du champ is_cancelled invisible pour la condition de visibilité -->
            <xpath expr="//field[@name='legend_done']" position="after">
                <field name="is_cancelled" invisible="1"/>
                <field name="is_closed" invisible="1"/>
            </xpath>

            <!-- Rendre le champ user_id obligatoire et filtrer les utilisateurs internes -->
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="required">1</attribute>
                <attribute name="domain">[('share', '=', False), ('active', '=', True)]</attribute>
            </xpath>

            <!-- Rendre le champ partner_id obligatoire et filtrer par is_customer -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="required">1</attribute>
                <attribute name="domain">[('is_customer', '=', True)]</attribute>
            </xpath>

            <!-- Rendre le champ partner_phone obligatoire -->
            <xpath expr="//field[@name='partner_phone']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>

            <!-- Masquer les champs date_deadline et source_id -->
            <xpath expr="//field[@name='email_cc']" position="after">
                <field name="date_deadline" invisible="1"/>
            </xpath>
            
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_company_name"/>
                <field name="source_id" invisible="1"/>
            </xpath>

            <!-- Numéro Orbus après le téléphone -->
            <xpath expr="//field[@name='email_cc']" position="before">
                <field name="numero_orbus"/>
            </xpath>

        </field>
    </record>

    <!-- Héritage de la vue formulaire helpdesk.stage pour ajouter le champ is_solve -->
    <record id="helpdesk_stage_view_form_inherit_solve" model="ir.ui.view">
        <field name="name">helpdesk.stage.view.form.inherit.solve</field>
        <field name="model">helpdesk.stage</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_stage_view_form"/>
        <field name="arch" type="xml">
            
            <!-- Ajout du champ is_solve après le champ fold -->
            <xpath expr="//field[@name='fold']" position="after">
                <field name="is_solve" string="Stage de résolution"/>
            </xpath>

        </field>
    </record>

</odoo>



