<odoo>

    <!--tree View-->
    <record id="tree_knowledge_tags_view" model="ir.ui.view">
        <field name="name">view.knowledge.tags.tree`</field>
        <field name="model">dev.knowledge.tags</field>
        <field name="arch" type="xml">
            <list string="Tags" editable='bottom'>
                <field name="name" required='1'/>
                <field name="color"/> 
            </list>
        </field>
    </record>

    <!--Action View-->
    <record id="action_knowledge_tags" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dev.knowledge.tags</field>
        <field name="view_mode">list</field>
    </record>

    <!--Menus-->
    <menuitem name="Tags" id="menu_knowledge_tags" parent='menu_dev_knowledge_configration' action="action_knowledge_tags" sequence='2'/>   
</odoo>
