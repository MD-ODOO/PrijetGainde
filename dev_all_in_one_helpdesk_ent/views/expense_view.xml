<odoo>
    <record id="form_expense_dev_expense_helpdesk_inherited" model="ir.ui.view">
        <field name="name">form_expense_dev_expense_helpdesk_inherited_name</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button string="Create Ticket" name="create_ticket" type="object" class="oe_highlight"
                        groups="dev_all_in_one_helpdesk_ent.group_expense_helpdesk_ticket"/>
            </xpath>
            <xpath expr="//sheet//div[1]" position="before">
<!--                attrs="{'invisible':[('ticket_count','=',0)]}"-->
                <div class="oe_button_box" name="button_box">
                    <button type="object"
                            invisible="ticket_count == 0"
                            name="action_view_ticket"
                            class="oe_stat_button"
                            icon="fa-chain">
                        <field name="ticket_count" widget="statinfo" string="Ticket"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
