#. module: dev_all_in_one_helpdesk_ent
#: model:mail.template,body_html:dev_all_in_one_helpdesk_ent.template_start_survey_dev_helpdesk_survey
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Dear,\n"
"                    <b>\n"
"                        <t t-out=\"object.ticket_id and object.ticket_id.partner_id and object.ticket_id.partner_id.name or ''\"/>\n"
"                    </b>\n"
"                    <br/>\n"
"                    <br/>\n"
"                    We are conducting a survey of\n"
"                    <strong t-out=\"object.survey_id and object.survey_id.title or ''\"/>\n"
"                    and your response would be appreciated.\n"
"                    <br/><br/>\n"
"                    </p><div>\n"
"                        <a t-attf-href=\"{{object.get_survey_url()}}\" style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color : #fff; border-radius: 5px; font-size:13px;\">\n"
"                            Start Survey\n"
"                        </a>\n"
"                    </div>\n"
"                    <br/>\n"
"                    Thank you for your interest.\n"
"                \n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Bonjour,\n"
"                    <b>\n"
"                        <t t-out=\"object.ticket_id and object.ticket_id.partner_id and object.ticket_id.partner_id.name or ''\"/>\n"
"                    </b>\n"
"                    <br/>\n"
"                    <br/>\n"
"                    Nous menons une enquête sur\n"
"                    <strong t-out=\"object.survey_id and object.survey_id.title or ''\"/>\n"
"                    et votre avis nous serait très précieux.\n"
"                    <br/><br/>\n"
"                    </p><div>\n"
"                        <a t-attf-href=\"{{object.get_survey_url()}}\" style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color : #fff; border-radius: 5px; font-size:13px;\">\n"
"                            Démarrer l'enquête\n"
"                        </a>\n"
"                    </div>\n"
"                    <br/>\n"
"                    Merci de l'intérêt que vous nous portez.\n"
"                \n"
"            </div>\n"
"        "

