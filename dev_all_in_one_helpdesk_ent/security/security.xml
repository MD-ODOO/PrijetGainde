<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_dev_helpdesk_task" model="res.groups">
            <field name="name">Allow Helpdesk Task</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Allow Helpdesk Task</field>
        </record>
        
        <record id="can_allow_export_purchase_portal" model="res.groups">
		<field name="name">Allow to export Purchase Orders report from portal</field>
		<field name="category_id" ref="base.module_category_hidden"/>
	</record>
	
	<record id="helpdesk.helpdesk_user_rule" model="ir.rule">
		<field name="domain_force">['|','|',('member_ids','in', user.id),
		                                   ('member_ids','=', False),
		                                   ('member_ids','in',[user.id]) ]</field>
		<field name="groups" eval="[(4, ref('helpdesk.group_helpdesk_user'))]"/>
        
	</record>
    
	<record id="helpdesk.helpdesk_ticket_user_rule" model="ir.rule">
		<field name="domain_force">['|', '|', '|',('team_id', '=', False), ('team_id.member_ids','in', user.id), ('team_id.member_ids','=', False),('multi_user_ids','in',[user.id])]</field>
		<field name="groups" eval="[(4, ref('helpdesk.group_helpdesk_user'))]"/>
	</record>
	
	 <record id="group_mass_update_ticket" model="res.groups">
            <field name="name">Allow Mass Update Tickets</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Allow to mass update tickets</field>
        </record>
        
        <record id="group_mass_assign_ticket" model="res.groups">
            <field name="name">Allow Assign Mass Ticket</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Allow to assign mass tickets</field>
        </record>
        
        <record id="group_expense_helpdesk_ticket" model="res.groups">
            <field name="name">Expense Helpdesk Ticket</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Allow to create Expense ticket</field>
        </record>
        
        <record id="group_dev_helpdesk_maintenance" model="res.groups">
            <field name="name">Allow Helpdesk Maintenance</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Allow Helpdesk Maintenance</field>
        </record>
        
        <record id="group_crm_helpdesk_ticket" model="res.groups">
            <field name="name">CRM Helpdesk Ticket</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Allow to create crm ticket</field>
        </record>
        
         <record id="group_dev_knowledge" model="res.groups">
        <field name="name">Odoo Knowledge</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">Allow Odoo Knowledge</field>
    </record>
    </data>
</odoo>
