<odoo>
    <!--form-->
    <record id="view_dev_mass_update_ticket_from" model="ir.ui.view">
        <field name="name">view.dev.mass.update.ticket.form</field>
        <field name="model">dev.mass.update.ticket</field>
        <field name="arch" type="xml">
            <form string="Mass Update">
               <group>
                    <group>
                        <field name="update_user"/>
                        <field name="team_user_ids" invisible="1"/>
                        <field name="team_id" 
                               options="{'no_create': True, 'no_create_edit':True}"
                               invisible="update_user == False"
                               required="update_user == True"
                               />
                        <field name="assing_user_id" domain="[('id','in',team_user_ids)]"
                               options="{'no_create': True, 'no_create_edit':True}"/>
                    </group>
                    <group invisible="1">
                        <field name="update_source"/>
                        <field name="source_id" 
                               options="{'no_create': True, 'no_create_edit':True}"
                               invisible="update_source == False"
                               required="update_source == True"
                               />
                    </group>
                    <group>
                        <field name="update_priority"/>
                        <field name="priority" widget='priority'
                               invisible="update_priority == False"
                               required="update_priority == True"
                             />
                    </group>
               </group>
               <footer>
                    <button string="Update" name="mass_update" type="object" class="oe_highlight"/>
                    <button string="Close" class="oe_link" special="cancel"/>
               </footer>
            </form>
        </field>
    </record>
    
   <!--Action-->
   <record id="action_mass_update_ticket" model="ir.actions.act_window">
        <field name="name">Mass Update</field>
        <field name="res_model">dev.mass.update.ticket</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_dev_mass_update_ticket_from"/>
		<field name="binding_model_id" ref="helpdesk.model_helpdesk_ticket"/>
		<field name="groups_id" eval="[(4, ref('dev_all_in_one_helpdesk_ent.group_mass_update_ticket'))]"/>
        <field name="target">new</field>
    </record>
</odoo>

