<odoo>
    <!--form-->
    <record id="view_dev_mass_ticket_assign_from" model="ir.ui.view">
        <field name="name">view.dev.mass.ticket.assign.form</field>
        <field name="model">dev.mass.ticket.assign</field>
        <field name="arch" type="xml">
            <form string="Mass Update">
               <group>
                    <group>
                        <field name="team_id" 
                               options="{'no_create': True, 'no_create_edit':True}"
                               required="1"/>
                    </group>
                    <group>
                        <field name="company_id" invisible="1"/>
                        <field name="allow_multi_user" invisible="1"/>
                        <field name="team_user_ids" invisible="1"/> 
                        <field name="assing_user_id" domain="[('id','in',team_user_ids)]" 
                               options="{'no_create': True, 'no_create_edit':True}"/>
<!--                         attrs="{'invisible':[('allow_multi_user','=',False)]}"-->
                        <field name="multi_user_ids" domain="[('id','in',team_user_ids)]"
                               options="{'no_create': True, 'no_create_edit':True}"
                               widget="many2many_tags" 
                             invisible="allow_multi_user == False"/>
                    </group>
               </group>
               <footer>
                    <button string="Update" name="action_update_team" type="object" class="oe_highlight"/>
                    <button string="Close Window" class="oe_link" special="cancel"/>
               </footer>
            </form>
        </field>
    </record>
    
   <!--Action-->
   <record id="action_mass_assign_user" model="ir.actions.act_window">
        <field name="name">Mass Assign User</field>
        <field name="res_model">dev.mass.ticket.assign</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_dev_mass_ticket_assign_from"/>
		<field name="binding_model_id" ref="helpdesk.model_helpdesk_ticket"/>
		<field name="groups_id" eval="[(4, ref('dev_all_in_one_helpdesk_ent.group_mass_assign_ticket'))]"/>
        <field name="target">new</field>
    </record>
    
</odoo>


