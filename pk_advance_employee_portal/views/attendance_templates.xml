<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Attendance List Page -->
    <template id="portal_attendance_view">
        <t t-call="portal.portal_layout">
            <div class="mt-3 text-start p-1">
                <a href="/my/home" class="btn btn-secondary">
                    <i class="fa fa-arrow-left me-1"></i>
                    Back
                </a>
            </div>

            <t t-if="request.session.get('warning')">
                <div class="alert alert-info text-center">
                    <t t-esc="request.session.get('warning')"/>
                </div>
                <!-- Clear the message after showing -->
                <t t-set="dummy" t-value="request.session.pop('warning', None)"/>
            </t>
            <t t-set="title">My Attendance</t>
            <div class="container my-4">
                <div class="card shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                        <h5 class="mb-0">My Attendance Records</h5>

                        <!-- Punch In / Out Buttons -->
                        <div class="d-flex gap-2 p-2">
                            <t t-if="not active_attendance">
                                <form action="/attendance/check_in" method="post">
                                    <input type="hidden" name="gps_location" id="gps_input_in"/>
                                    <button type="submit" class="btn btn-success">
                                        <i class="fa fa-sign-in-alt me-1"></i>
                                        Check In
                                    </button>
                                </form>
                            </t>
                            <t t-if="active_attendance and not active_attendance.check_out">
                                <form action="/attendance/check_out" method="post">
                                    <input type="hidden" name="gps_location" id="gps_input_out"/>
                                    <button type="submit" class="btn btn-danger">
                                        <i class="fa fa-sign-out-alt me-1"></i>
                                        Check Out
                                    </button>
                                </form>
                            </t>
                        </div>
                        <!-- Lunch In / Out Buttons -->
                        <div class="d-flex gap-2 p-2">
                            <t t-if="active_attendance and not active_attendance.lunch_in">
                                <form action="/attendance/lunch_in" method="post">
                                    <button type="submit" class="btn btn-warning">
                                        <i class="fa fa-utensils me-1"></i>
                                        Lunch In
                                    </button>
                                </form>
                            </t>
                            <t t-if="active_attendance and active_attendance.lunch_in and not active_attendance.lunch_out">
                                <form action="/attendance/lunch_out" method="post">
                                    <button type="submit" class="btn btn-info">
                                        <i class="fa fa-coffee me-1"></i>
                                        Lunch Out
                                    </button>
                                </form>
                            </t>
                        </div>


                        <script>
                            function handleGPSSubmission(form, inputId) {
                            if (navigator.geolocation) {
                            event.preventDefault(); // stop the form from submitting immediately
                            navigator.geolocation.getCurrentPosition(function (position) {
                            document.getElementById(inputId).value =
                            position.coords.latitude + ',' + position.coords.longitude;
                            form.submit(); // submit only after location is set
                            }, function (error) {
                            alert("Location access denied or unavailable. Please enable GPS.");
                            form.submit(); // fallback if denied
                            }, {
                            enableHighAccuracy: true,
                            timeout: 10000
                            });
                            } else {
                            alert("Geolocation is not supported by this browser.");
                            form.submit();
                            }
                            }

                            document.querySelectorAll('form[action="/attendance/check_in"]').forEach(f => {
                            f.addEventListener('submit', function (event) {
                            handleGPSSubmission(f, 'gps_input_in');
                            });
                            });

                            document.querySelectorAll('form[action="/attendance/check_out"]').forEach(f => {
                            f.addEventListener('submit', function (event) {
                            handleGPSSubmission(f, 'gps_input_out');
                            });
                            });
                        </script>
                        <!-- Filter Form -->
                        <form method="get" class="row g-2">
                            <!-- Date From -->
                            <div class="col-auto">
                                <input type="text" name="date_start"
                                       class="form-control"
                                       t-att-value="date_start or ''"
                                       placeholder="Date From"
                                       onfocus="(this.type='date')"
                                       onblur="if(!this.value)this.type='text'"/>
                            </div>
                            <!-- Date To -->
                            <div class="col-auto">
                                <input type="text" name="date_end"
                                       class="form-control"
                                       t-att-value="date_end or ''"
                                       placeholder="Date To"
                                       onfocus="(this.type='date')"
                                       onblur="if(!this.value)this.type='text'"/>
                            </div>
                            <!-- State -->
                            <!--                            <div class="col-auto">-->
                            <!--                                <select name="state" class="form-select">-->
                            <!--                                    <option value="">All States</option>-->
                            <!--                                    <t t-foreach="[('draft', 'Draft'), ('approved', 'Approved'), ('refused', 'Refused')]" t-as="st">-->
                            <!--                                        <option t-att-value="st[0]" t-att-selected="state == st[0]">-->
                            <!--                                            <t t-esc="st[1]"/>-->
                            <!--                                        </option>-->
                            <!--                                    </t>-->
                            <!--                                </select>-->
                            <!--                            </div>-->
                            <!-- Button -->
                            <div class="col-auto">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-filter me-1"></i>
                                    Filter
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="card-body">
                        <!-- Attendance Records Table -->
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Check In</th>
                                        <th>Check Out</th>
                                        <th>Hours Worked</th>
                                        <th>Lunch Hours</th>
                                        <th>Net Hours</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="attendances" t-as="attendance">
                                        <tr>
                                            <td>
                                                <t t-esc="attendance.check_in.astimezone(user_tz).strftime('%Y-%m-%d %H:%M:%S') if attendance.check_in else ''"/>
                                            </td>
                                            <td>
                                                <t t-if="attendance.check_out">
                                                    <t t-esc="attendance.check_out.astimezone(user_tz).strftime('%Y-%m-%d %H:%M:%S') if attendance.check_out else ''"/>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-muted">Not checked out</span>
                                                </t>
                                            </td>
                                            <td>
                                                <t t-if="attendance.check_out">
                                                    <t t-esc="('%d:%02d' % (int(attendance.worked_hours), int(attendance.worked_hours*60 + 0.999) % 60)) if attendance.worked_hours else '0:00'"/>
                                                </t>
                                                <t t-else="">-</t>
                                            </td>
                                            <td>
                                                <t t-esc="('%d:%02d' % (int(attendance.lunch_hours), int((attendance.lunch_hours*60) % 60))) if attendance.lunch_hours else '0:00'"/>
                                            </td>
                                            <td>
                                                <t t-esc="('%d:%02d' % (int(attendance.net_hours), int(attendance.net_hours * 60 + 0.999) % 60)) if attendance.net_hours else '0:00'"/>
                                            </td>

                                            <td>
                                                <t t-if="attendance.check_out">
                                                    <span class="badge bg-success">Completed</span>
                                                </t>
                                                <t t-else="">
                                                    <span class="badge bg-warning">In Progress</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-if="not attendances">
                                        <tr>
                                            <td colspan="5" class="text-center text-muted">No attendance records
                                                found.
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                        </div>
                        <div t-if="pager" class="o_portal_pager d-flex justify-content-center my-3">
                <t t-call="portal.pager"/>
            </div>

                        <!-- Pagination -->


                        <!--                        <div class="text-end mt-3">-->
                        <!--                            <a href="/attendance/my" class="btn btn-secondary">-->
                        <!--                                <i class="fa fa-arrow-left me-1"></i>-->
                        <!--                                Back to Attendance-->
                        <!--                            </a>-->
                        <!--                        </div>-->
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
