<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
       <template id="ad_employee_leave_form_view_temp_id" name="Employee Leave Portal Combined">
    <t t-call="portal.portal_layout">
        <div class="container my-4">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="mt-3 text-start">
                    <a href="/my/home" class="btn btn-secondary">
                        <i class="fa fa-arrow-left me-1"></i> Back
                    </a>
                </div>
                <h4 class="mb-0 text-center flex-grow-1">My Leave Summary</h4>
                <div class="d-flex gap-2">
                    <a href="/timeoff/calendar" class="btn btn-info">
                        <i class="fa fa-calendar me-1"></i> Team Calendar
                    </a>
                    <a href="/my/leaves/new" class="btn btn-primary">
                        <i class="fa fa-plus"></i> New Request
                    </a>
                </div>
            </div>

            <!-- Remaining Leave Balances -->
            <t t-if="remaining_leave_days_by_type">
                <div class="alert alert-light shadow-sm border mb-4">
                    <h5 class="fw-bold mb-3 text-primary">Remaining Leave Balances</h5>
                    <div class="row">
                        <t t-foreach="remaining_leave_days_by_type.items()" t-as="item">
                            <div class="col-md-3 col-sm-6 mb-2">
                                <div class="p-3 border rounded-2 text-center bg-light">
                                    <strong><t t-esc="item[0]"/></strong><br/>
                                    <span class="text-success fw-bold">
                                        <t t-esc="item[1]"/> days remaining
                                    </span>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>

            <!-- Combined Leave Table -->
            <t t-if="checkouts">
                <table class="table table-bordered table-hover shadow-sm">
                    <thead class="table-light">
                        <tr>
                            <th>Leave Type</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Duration</th>
                            <th>Request Status</th>
                            <th>Leave Status</th>
                        </tr>
                    </thead>
                    <tbody>
                         <t t-foreach="checkouts" t-as="leave">
                            <tr t-attf-style="background-color: #{'f8d7da' if leave.date_from &lt; (datetime.datetime.now()) else 'd1e7dd'};">
                                <td><span t-out="leave.holiday_status_id.name"/></td>
                                <td><span t-out="leave.date_from" t-options="{'widget': 'datetime', 'format': 'MMM dd, yyyy, h:mm a'}"/></td>
                                <td><span t-out="leave.date_to" t-options="{'widget': 'datetime', 'format': 'MMM dd, yyyy, h:mm a'}"/></td>
                                    <td><span t-out="leave.duration_display"/></td>
                                <td>
                                    <t t-if="leave.state == 'validate'">
                                        <span class="badge bg-success">Approved</span>
                                    </t>
                                    <t t-elif="leave.state == 'cancel'">
                                        <span class="badge bg-danger">Cancelled</span>
                                    </t>
                                    <t t-elif="leave.state == 'refuse'">
                                        <span class="badge bg-danger">Refused</span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge bg-primary">In Process</span>
                                    </t>
                                </td>
                                <td>
                                    <!-- Rejected -->
                                    <t t-if="leave.state in ['refuse', 'cancel']">
                                        <span class="badge bg-danger">Rejected</span>
                                    </t>

                                    <!-- Upcoming -->
                                    <t t-elif="leave.state == 'validate'
                                               and datetime.datetime.now() &lt; leave.date_from">
                                        <span class="badge bg-success">Upcoming</span>
                                        <t t-if="leave.date_from &gt; datetime.datetime.now()">
                                                    <a t-att-href="'/my/leaves/cancel/%s' % leave.id"
                                                       class="badge bg-danger" style="cursor:pointer;">
                                                        Cancel Leave
                                                    </a>
                                                </t>

                                    </t>

                                    <!-- Ongoing -->
                                    <t t-elif="leave.state == 'validate'
                                               and leave.date_from &lt;= datetime.datetime.now()
                                               and leave.date_to &gt;= datetime.datetime.now()">
                                        <span class="badge bg-primary">Ongoing</span>
                                    </t>

                                    <!-- Used -->
                                    <t t-elif="leave.state == 'validate'
                                               and leave.date_to &lt; datetime.datetime.now()">
                                        <span class="badge bg-secondary">Used</span>
                                    </t>

                                    <!-- Pending (In Process) -->
                                    <t t-elif="leave.state in ['confirm', 'validate1']">
                                        <span class="badge bg-warning">Pending</span>
                                    </t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
            <t t-else="">
                <div class="alert alert-warning text-center" role="alert">
                    No leave Data found.
                </div>
            </t>

            <!-- Pager -->
            <div t-if="pager" class="o_portal_pager d-flex justify-content-center my-3">
                <t t-call="portal.pager"/>
            </div>

        </div>
    </t>
</template>



<!--    submit leave request template-->
<template id="ad_portal_leave_create_template" name="Leave Request Form">
    <t t-call="portal.portal_layout">
        <t t-set="breadcrumbs_create_leaves" t-value="'Request New Leave'" />
        <div class="container mt-4 mb-4">
            <div class="mt-3 text-start">
                <a href="/employee/leaves" class="btn btn-secondary">
                    <i class="fa fa-arrow-left me-1"></i>
                    Back
                </a>
            </div>
            <h3 class="mb-3">Request New Leave</h3>
            <form action="/my/leaves/create" method="POST" class="oe_website_form form-horizontal" id="leaveRequestForm" enctype="multipart/form-data">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <div class="form-group row">
                    <label for="leave_type_id" class="col-sm-3 col-form-label">Leave Type</label>
                    <div class="col-sm-9">
                       <select name="leave_type" id="leave_type" class="form-control" required="required">
                        <option value="">Select Type</option>
                        <t t-foreach="leave_types" t-as="lt">
                            <option t-att-value="lt.id" t-att-data-request-unit="lt.request_unit">
                                <t t-esc="lt.name" />
                            </option>
                        </t>
                    </select>
                    </div>
                </div>

                <!-- Fields for 'day' type (default) -->
                <div id="day_fields">
                    <div class="form-group row">
                        <label for="request_date_from" class="col-sm-3 col-form-label">From Date</label>
                        <div class="col-sm-9">
                            <input type="date" name="request_date_from" id="request_date_from" class="form-control"/>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="request_date_to" class="col-sm-3 col-form-label">To Date</label>
                        <div class="col-sm-9">
                            <input type="date" name="request_date_to" id="request_date_to" class="form-control"/>
                        </div>
                    </div>
                </div>

                <!-- Fields for 'half_day' type -->
                <div id="half_day_fields" style="display: none;">
                    <div class="form-group row">
                        <label for="half_day_date" class="col-sm-3 col-form-label">Date</label>
                        <div class="col-sm-9">
                            <input type="date" name="half_day_date" id="half_day_date" class="form-control"/>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="request_unit_half" class="col-sm-3 col-form-label">Half Day</label>
                        <div class="col-sm-9">
                            <select name="request_unit_half" id="request_unit_half" class="form-control">
                                <option value="morning">Morning</option>
                                <option value="afternoon">Afternoon</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Fields for 'hour' type -->
                <div id="hour_fields" style="display: none;">
                    <div class="form-group row">
                        <label for="hour_date_from" class="col-sm-3 col-form-label">From Date</label>
                        <div class="col-sm-9">
                            <input type="date" name="hour_date_from" id="hour_date_from" class="form-control"/>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="hour_time_from" class="col-sm-3 col-form-label">From Time</label>
                        <div class="col-sm-9">
                            <input type="time" name="hour_time_from" id="hour_time_from" class="form-control"/>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="hour_date_to" class="col-sm-3 col-form-label">To Date</label>
                        <div class="col-sm-9">
                            <input type="date" name="hour_date_to" id="hour_date_to" class="form-control"/>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label for="hour_time_to" class="col-sm-3 col-form-label">To Time</label>
                        <div class="col-sm-9">
                            <input type="time" name="hour_time_to" id="hour_time_to" class="form-control"/>
                        </div>
                    </div>
                </div>

                <div class="form-group row">
                    <label for="reason" class="col-sm-3 col-form-label">Reason</label>
                    <div class="col-sm-9">
                        <textarea name="reason" class="form-control" rows="3" placeholder="Reason..."></textarea>
                    </div>
                </div>

                <!-- Attachments Section with Add/Remove functionality -->
                <div class="form-group row">
                    <label class="col-sm-3 col-form-label">Attachments</label>
                    <div class="col-sm-9">
                        <div class="mb-2">
                            <button type="button" class="btn btn-primary btn-sm" id="addAttachmentBtn">
                                <i class="fa fa-plus me-1"></i>Add Attachment
                            </button>
                        </div>

                        <!-- Hidden file input -->
                        <input type="file" id="fileInput" style="display: none;"
                               accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.txt,.xls,.xlsx"/>

                        <!-- List of selected files -->
                        <div id="attachmentsList" class="mt-2"></div>

                        <small class="form-text text-muted">
                            Optional. Click "Add Attachment" to select files. Accepted formats: PDF, Word, Excel, Images, Text (Max 10MB per file)
                        </small>
                    </div>
                </div>

                <div class="d-flex justify-content-center form-group row">
                    <div class="offset-sm-3 col-sm-9">
                        <button type="submit" class="btn btn-success mt-3">Submit Leave Request</button>
                        <a href="/employee/leaves" class="btn btn-secondary mt-3">Cancel</a>
                    </div>
                </div>
            </form>
        </div>

        <!-- JavaScript for handling attachments and field visibility -->
        <script type="text/javascript">
            document.addEventListener('DOMContentLoaded', function() {
                const leaveTypeSelect = document.getElementById('leave_type');
                const dayFields = document.getElementById('day_fields');
                const halfDayFields = document.getElementById('half_day_fields');
                const hourFields = document.getElementById('hour_fields');

                // Attachment handling
                const addAttachmentBtn = document.getElementById('addAttachmentBtn');
                const fileInput = document.getElementById('fileInput');
                const attachmentsList = document.getElementById('attachmentsList');
                const form = document.getElementById('leaveRequestForm');
                let selectedFiles = [];

                // Leave type field visibility
                function updateFieldVisibility() {
                    const selectedOption = leaveTypeSelect.options[leaveTypeSelect.selectedIndex];
                    const requestUnit = selectedOption.getAttribute('data-request-unit');

                    dayFields.style.display = 'none';
                    halfDayFields.style.display = 'none';
                    hourFields.style.display = 'none';

                    clearFields(dayFields);
                    clearFields(halfDayFields);
                    clearFields(hourFields);

                    if (requestUnit === 'day') {
                        dayFields.style.display = 'block';
                        setRequired(dayFields, true);
                    } else if (requestUnit === 'half_day') {
                        halfDayFields.style.display = 'block';
                        setRequired(halfDayFields, true);
                    } else if (requestUnit === 'hour') {
                        hourFields.style.display = 'block';
                        setRequired(hourFields, true);
                    }
                }

                function clearFields(container) {
                    const inputs = container.querySelectorAll('input, select');
                    inputs.forEach(input => {
                        input.value = '';
                        input.removeAttribute('required');
                    });
                }

                function setRequired(container, required) {
                    const inputs = container.querySelectorAll('input, select');
                    inputs.forEach(input => {
                        if (required) {
                            input.setAttribute('required', 'required');
                        } else {
                            input.removeAttribute('required');
                        }
                    });
                }

                leaveTypeSelect.addEventListener('change', updateFieldVisibility);

                if (leaveTypeSelect.value) {
                    updateFieldVisibility();
                }

                // Attachment handling functions
                addAttachmentBtn.addEventListener('click', function() {
                    fileInput.click();
                });

                fileInput.addEventListener('change', function(e) {
                    const files = Array.from(e.target.files);

                    files.forEach(file => {
                        // Check file size (10MB)
                        const maxSize = 10 * 1024 * 1024;
                        if (file.size > maxSize) {
                            alert(`File "${file.name}" exceeds 10MB limit and will not be added.`);
                            return;
                        }

                        // Check if file already added
                        const isDuplicate = selectedFiles.some(f =>
                            f.name === file.name &amp;&amp; f.size === file.size
                        );

                        if (!isDuplicate) {
                            selectedFiles.push(file);
                        }
                    });

                    renderAttachmentsList();
                    fileInput.value = ''; // Reset file input
                });

                function renderAttachmentsList() {
                    attachmentsList.innerHTML = '';

                    if (selectedFiles.length === 0) {
                        return;
                    }

                    const listGroup = document.createElement('div');
                    listGroup.className = 'list-group mb-2';

                    selectedFiles.forEach((file, index) => {
                        const fileItem = document.createElement('div');
                        fileItem.className = 'list-group-item d-flex justify-content-between align-items-center py-2';

                        const fileInfo = document.createElement('div');
                        fileInfo.className = 'd-flex align-items-center';

                        const fileIcon = document.createElement('i');
                        fileIcon.className = 'fa fa-file me-2';

                        const fileName = document.createElement('span');
                        fileName.textContent = file.name;
                        fileName.className = 'me-2';

                        const fileSize = document.createElement('small');
                        fileSize.textContent = `(${formatFileSize(file.size)})`;
                        fileSize.className = 'text-muted';

                        fileInfo.appendChild(fileIcon);
                        fileInfo.appendChild(fileName);
                        fileInfo.appendChild(fileSize);

                        const removeBtn = document.createElement('button');
                        removeBtn.type = 'button';
                        removeBtn.className = 'btn btn-sm btn-danger';
                        removeBtn.innerHTML = '<i class="fa fa-trash"></i>';
                        removeBtn.onclick = function() {
                            removeFile(index);
                        };

                        fileItem.appendChild(fileInfo);
                        fileItem.appendChild(removeBtn);
                        listGroup.appendChild(fileItem);
                    });

                    attachmentsList.appendChild(listGroup);
                }

                function removeFile(index) {
                    selectedFiles.splice(index, 1);
                    renderAttachmentsList();
                }

                function formatFileSize(bytes) {
                    if (bytes === 0) return '0 Bytes';
                    const k = 1024;
                    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
                    const i = Math.floor(Math.log(bytes) / Math.log(k));
                    return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
                }

                // On form submit, append files to FormData
                form.addEventListener('submit', function(e) {
                    // Remove any existing file inputs with name 'attachments'
                    const existingInputs = form.querySelectorAll('input[name="attachments"]');
                    existingInputs.forEach(input => input.remove());

                    // Add selected files to form
                    selectedFiles.forEach((file, index) => {
                        const fileInputHidden = document.createElement('input');
                        fileInputHidden.type = 'file';
                        fileInputHidden.name = 'attachments';
                        fileInputHidden.style.display = 'none';

                        // Create a DataTransfer object to assign the file
                        const dataTransfer = new DataTransfer();
                        dataTransfer.items.add(file);
                        fileInputHidden.files = dataTransfer.files;

                        form.appendChild(fileInputHidden);
                    });
                });
            });
        </script>

        <style>
            #attachmentsList .list-group-item {
                background-color: #f8f9fa;
                border: 1px solid #dee2e6;
            }

            #attachmentsList .list-group-item:hover {
                background-color: #e9ecef;
            }
        </style>
    </t>
</template>


  <template id="portal_timeoff_calendar_template" name="Time Off Calendar">
    <t t-call="portal.portal_layout">
        <t t-set="title">Team Time Off Calendar</t>
        <div class="container my-4">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Team Time Off Calendar</h5>
                    <a href="/employee/leaves" class="btn btn-secondary">
                        <i class="fa fa-arrow-left me-1"></i> Back
                    </a>
                </div>
                <div class="card-body">
                    <div id="timeoff_calendar"></div>
                </div>
            </div>
        </div>

        <!-- Pass data as JSON to JavaScript -->
        <t t-set="events_json">
            [
            <t t-foreach="leaves" t-as="leave">
                {
                    title: <t t-esc="json.dumps(leave.employee_id.name + ' (' + leave.holiday_status_id.name + ')')"/>,
                    start: <t t-esc="json.dumps(leave.date_from.strftime('%Y-%m-%dT%H:%M:%S'))"/>,
                    end: <t t-esc="json.dumps(leave.date_to.strftime('%Y-%m-%dT%H:%M:%S'))"/>,
                    color: "#4CAF50"
                }<t t-if="leave != leaves[-1]">,</t>
            </t>
            ]
        </t>

        <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.4/index.global.min.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var calendarEl = document.getElementById('timeoff_calendar');
                var events = <t t-raw="events_json"/>;

                var calendar = new FullCalendar.Calendar(calendarEl, {
                    initialView: 'dayGridMonth',
                    height: 'auto',
                    headerToolbar: {
                        left: 'prev,next today',
                        center: 'title',
                        right: 'dayGridMonth,timeGridWeek,timeGridDay'
                    },
                    events: events
                });
                calendar.render();
            });
        </script>
    </t>
</template>


</odoo>