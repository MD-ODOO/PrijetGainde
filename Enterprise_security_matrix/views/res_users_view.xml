<odoo>

    <record id="view_users_form_security_matrix" model="ir.ui.view">
        <field name="name">res.users.security.matrix</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Security Scope">
                    <field name="allowed_analytic_account_ids" widget="many2many_tags"/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>